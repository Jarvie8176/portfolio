---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base
  title={`Colophon · ${site.name}`}
  description="How this portfolio is made: Astro, Tailwind, editorial research materials, and lightweight static pages."
  crumb="colophon"
>
  <main class="doc">
    <section class="hero">
      <span class="label kicker">site · colophon</span>
      <h1>Colophon</h1>
    </section>

    <hr class="rule rule--hard" />

    <p>This site is a static build: Astro with Tailwind, set in CJK-safe Noto
    type families. The visual language is an editorial research surface:
    project materials, honest status marks, and enough structure to keep claims
    inspectable.</p>

    <p>The homepage uses a small observer to keep the practice index aligned
    with the section in view. Motion stays quiet, and the site remains a static
    document first.</p>

    <p>Status marks follow the homepage taxonomy: <span class="stamp stamp--live">In use</span>{' '}
    for real running loops, <span class="stamp stamp--proto">Active prototype</span>{' '}
    for working prototypes with open validation, and <span class="stamp">Concept study</span>{' '}
    for design-stage work. The absence of a claim is itself a record.</p>
  </main>
</Base>

<style>
  .hero { margin: 0 0 var(--sp-2); }
  .hero .kicker { display: block; margin-bottom: 1.1rem; }
  .hero h1 {
    font-size: var(--fs-h1);
    line-height: 1.02;
    font-weight: 600;
    margin: 0;
    letter-spacing: -0.01em;
  }
</style>
