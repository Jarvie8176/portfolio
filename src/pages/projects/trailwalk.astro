---
import Analytics from "../../components/Analytics.astro";
import TrailwalkGallery from "../../components/trailwalk/TrailwalkGallery.astro";
import { build } from "../../data/build";
import { deployment, displayHost, site } from "../../data/site";

// Email and development links can be injected at build time; see src/data/site.ts.
const contactEmail = deployment.contactEmail;
const updatesEmailHref = contactEmail
    ? `mailto:${contactEmail}?subject=Trailwalk%20updates`
    : undefined;
const updateHref = deployment.updatesUrl;
const updateLabel = displayHost(updateHref);
const canonical = Astro.site
    ? new URL(Astro.url.pathname, Astro.site)
    : undefined;
const socialImage = Astro.site
    ? new URL(
          "/assets/project-covers/trailwalk-hero-background.webp",
          Astro.site,
      )
    : undefined;
const commitUrl =
    build.version === "local"
        ? undefined
        : `${site.repoUrl}/commit/${build.version}`;
const shorelineTrailHref =
    "https://www.google.com/maps/search/?api=1&query=Shoreline%20Trail%20Port%20Moody%20BC";
const saintAnthonyViewHref =
    "https://www.google.com/maps/search/?api=1&query=iceberg%20view%20mountain%20viewpoint%20Saint%20Anthony%20NL";

const navItems = [
    { href: "#problem", label: "The Problem", analyticsId: "problem" },
    { href: "#origin", label: "Origin Story", analyticsId: "origin" },
    { href: "#gallery", label: "Gallery", analyticsId: "gallery" },
    { href: "#experience", label: "The Experience", analyticsId: "experience" },
    { href: "#audience", label: "Who It Helps", analyticsId: "audience" },
    { href: "#faq", label: "FAQ", analyticsId: "faq" },
    { href: "#contact", label: "Contact", analyticsId: "contact" },
    {
        href: "#stay-in-the-loop",
        label: "Request Updates",
        analyticsId: "request_updates",
    },
];

const experienceItems = [
    {
        title: "Real Trails, Coast to Coast",
        body: "From the Pacific coast to the Easternmost Point of Canada, we have walked and captured terabytes of high-fidelity walking experiences across Metro Vancouver, BC, Cape Spear, NL, Gros Morne National Park, NL, Cape Breton Island, NS, and more.",
    },
    {
        title: "The Sound of Being There",
        body: "Birds, water, wind, footsteps: recorded in spatial audio so the world feels present around you.",
    },
    {
        title: "At Your Own Pace",
        body: "Walk with support, sit comfortably, or use a wheelchair. Built for different paces and ways of moving.",
    },
];

const audiences = [
    {
        title: "When getting outdoors takes support",
        body: "For people whose age, recovery, mobility, energy, or support needs make outdoor trails harder to reach.",
    },
    {
        title: "When care happens indoors",
        body: "Bring real outdoor places into homes, care settings, and shared community spaces.",
    },
    {
        title: "When weather closes the trail",
        body: "Stay connected to familiar paths through winter, storms, smoke, or unsafe conditions.",
    },
    {
        title: "When distance gets in the way",
        body: "Return to real places when time, geography, or circumstance makes going back difficult.",
    },
    {
        title: "For shared walks",
        body: "Give families, caregivers, and friends a calmer way to experience outdoor places together.",
    },
    {
        title: "For community programs",
        body: "Help recreation, accessibility, and senior programs offer real nature-based experiences indoors.",
    },
];

const faqs = [
    {
        analyticsId: "replace_outdoors",
        question: "Does this replace going outside?",
        answer: "No. Trailwalk encourages outdoor access whenever it is possible. It helps people stay connected to outdoor places when going outside is hard, unsafe, or not possible.",
    },
    {
        analyticsId: "different_360",
        question: "How is this different from 360 videos online?",
        answer: "Trailwalk combines high-quality spatial audio, community trails that local people walk every day, and playback that can follow your walking speed.",
    },
    {
        analyticsId: "able_to_walk",
        question: "Do I have to be able to walk?",
        answer: "No. Walk with support, sit comfortably, use a wheelchair, or control playback manually. We hope the experience feels atmospheric and meditative, not demanding.",
    },
    {
        analyticsId: "try_now",
        question: "Can I try it now?",
        answer: "Trailwalk is at concept stage with a working VR prototype. Get in touch and we'll include you when demo sessions open.",
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Trailwalk · Walking in Nature is not a privilege</title>
        <meta
            name="description"
            content="Trailwalk helps people stay connected to real outdoor places through immersive 360-degree trail walks and spatial outdoor sound."
        />
        <meta name="author" content={site.name} />
        {canonical && <link rel="canonical" href={canonical} />}
        <meta
            property="og:title"
            content="Trailwalk · Walking in Nature is not a privilege"
        />
        <meta
            property="og:description"
            content="Immersive 360-degree trail walks for everyone who has been separated from the outdoors."
        />
        <meta property="og:type" content="article" />
        <meta property="og:site_name" content={site.name} />
        {canonical && <meta property="og:url" content={canonical} />}
        {socialImage && <meta property="og:image" content={socialImage} />}
        <meta name="twitter:card" content="summary_large_image" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&family=Lora:ital,wght@0,400;0,500;0,600;1,400&display=swap"
            rel="stylesheet"
        />
        <Analytics />
    </head>
    <body>
        <div class="accent-bar" aria-hidden="true"></div>
        <header class="page-nav" aria-label="Trailwalk navigation">
            <div class="nav-identity">
                <a
                    class="nav-home"
                    href="/"
                    aria-label="Back to portfolio home"
                    data-umami-event="trailwalk_nav_click"
                    data-umami-event-section="portfolio_home"
                    data-umami-event-placement="header"
                >
                    <span aria-hidden="true">←</span>
                    <span>Portfolio</span>
                </a>
                <a
                    class="nav-brand"
                    href="#hero"
                    aria-current="page"
                    data-umami-event="trailwalk_nav_click"
                    data-umami-event-section="hero"
                    data-umami-event-placement="header"
                >
                    Trailwalk
                </a>
            </div>
            <nav class="page-nav__links">
                {
                    navItems.map((item) => (
                        <a
                            href={item.href}
                            data-umami-event="trailwalk_nav_click"
                            data-umami-event-section={item.analyticsId}
                            data-umami-event-placement="header"
                        >
                            {item.label}
                        </a>
                    ))
                }
            </nav>
            <details class="mobile-nav">
                <summary aria-label="Trailwalk sections">
                    <span class="mobile-nav__icon" aria-hidden="true"></span>
                    <span class="sr-only">Sections</span>
                </summary>
                <nav aria-label="Trailwalk mobile sections">
                    {
                        navItems.map((item) => (
                            <a
                                href={item.href}
                                data-umami-event="trailwalk_nav_click"
                                data-umami-event-section={item.analyticsId}
                                data-umami-event-placement="mobile_menu"
                            >
                                {item.label}
                            </a>
                        ))
                    }
                </nav>
            </details>
        </header>

        <main>
            <section class="hero" id="hero" aria-labelledby="hero-title">
                <div class="hero-photo" aria-hidden="true"></div>
                <video
                    class="hero-video"
                    autoplay
                    loop
                    muted
                    playsinline
                    preload="metadata"
                    poster="/assets/project-covers/trailwalk-hero-background.webp"
                    aria-hidden="true"
                >
                    <source
                        src="/assets/project-covers/trailwalk-hero-loop.mp4"
                        type="video/mp4"
                    />
                </video>
                <div class="hero-overlay" aria-hidden="true"></div>
                <svg
                    class="contours"
                    viewBox="0 0 1440 900"
                    preserveAspectRatio="none"
                    fill="none"
                    aria-hidden="true"
                >
                    <path
                        d="M-50,140 C200,120 480,200 740,170 S1120,120 1500,175"
                    ></path>
                    <path
                        d="M-50,260 C280,240 520,310 780,278 S1160,235 1500,285"
                    ></path>
                    <path
                        d="M-50,400 C180,380 460,450 730,420 S1080,375 1500,425"
                    ></path>
                    <path
                        d="M-50,530 C320,510 560,575 830,545 S1240,500 1500,550"
                    ></path>
                    <path
                        d="M-50,660 C200,645 500,710 800,680 S1120,640 1500,685"
                    ></path>
                    <path
                        d="M-50,780 C260,765 540,810 840,785 S1200,750 1500,790"
                    ></path>
                </svg>

                <div class="hero-inner">
                    <span class="hero-status">
                        Concept stage · working VR prototype · field media library
                    </span>
                    <h1 id="hero-title">
                        Walking in Nature<br />is not a privilege
                    </h1>
                    <p>
                        Immersive 360-degree trail walks for everyone who has
                        been separated from the outdoors.
                    </p>
                    <div class="hero-actions" aria-label="Trailwalk actions">
                        <a
                            class="button button-light"
                            href="/contact/"
                            data-umami-event="trailwalk_cta_click"
                            data-umami-event-cta="request_demo"
                            data-umami-event-placement="hero"
                        >
                            Request a demo
                        </a>
                        <a
                            class="button button-ghost"
                            href="#stay-in-the-loop"
                            data-umami-event="trailwalk_cta_click"
                            data-umami-event-cta="follow_updates"
                            data-umami-event-placement="hero"
                        >
                            Follow updates
                        </a>
                    </div>
                </div>
                <p class="hero-footnote">
                    Lone Shieling Trail, Pleasant Bay, NS
                </p>
            </section>

            <section class="problem-section" id="problem">
                <div class="problem-inner">
                    <div class="text-column">
                        <h2>
                            Being separated from the outdoors is a shared
                            experience
                        </h2>
                        <p class="body-copy">
                            For some, getting outdoors takes support: age,
                            mobility, recovery, energy, or the realities of care
                            settings. For others, the barrier comes with the
                            season: winter, storms, smoke, or unsafe trail
                            conditions. And sometimes the places that matter are
                            simply too far away to return to often.
                        </p>
                        <p class="body-copy">
                            My mother and grandmother love being outdoors too.
                            But in their 60s and 80s, a long trip to visit the
                            trails here in BC is not always a realistic option.
                        </p>
                        <p class="pull-quote">
                            Unlike VR walking games or generated worlds,
                            Trailwalk starts with real places: spatial outdoor
                            sound and immersive 360-degree capture that help
                            people stay connected to trails at a pace and
                            posture that works for them.
                        </p>
                    </div>
                    <figure class="problem-photo">
                        <img
                            src="/assets/project-covers/trailwalk-family-outdoors.webp"
                            width="1200"
                            height="1432"
                            alt="Two older family members visiting a forest canopy walkway in BC"
                            loading="lazy"
                            decoding="async"
                        />
                        <figcaption>Family visit in BC, 2023</figcaption>
                    </figure>
                </div>
            </section>

            <section
                class="origin-section"
                id="origin"
                aria-labelledby="origin-title"
            >
                <div class="origin-inner">
                    <div>
                        <p class="section-kicker">Field Origin</p>
                        <h2 id="origin-title">Born from real walks</h2>
                    </div>
                    <div class="origin-copy">
                        <p>
                            Trailwalk began with field walks in real weather:
                            rain through forest canopy, wet leaves underfoot,
                            gravel, puddles, and the quiet shift that happens
                            when movement and sound pull attention back into the
                            body.
                        </p>
                        <p>
                            The early insight came before perfect fidelity: even
                            rough 360-degree footage in a headset, paired with
                            walking and outdoor sound, could help the body
                            remember the feeling of being outside.
                        </p>
                        <p class="origin-note">
                            Field samples include an afternoon walk on <a
                                href={shorelineTrailHref}
                                target="_blank"
                                rel="noreferrer"
                                data-umami-event="trailwalk_origin_link_click"
                                data-umami-event-location="shoreline_trail"
                                >Shoreline Trail in Port Moody, BC</a
                            > and <a
                                href={saintAnthonyViewHref}
                                target="_blank"
                                rel="noreferrer"
                                data-umami-event="trailwalk_origin_link_click"
                                data-umami-event-location="saint_anthony_view"
                                >an iceberg view from a mountain viewpoint in
                                Saint Anthony, NL</a
                            >.
                        </p>
                    </div>
                </div>
            </section>

            <TrailwalkGallery />

            <div class="waveform-wrap" aria-hidden="true">
                <svg viewBox="0 0 200 20" class="waveform" fill="none">
                    <path
                        d="M0,10 L28,10 L36,3 L44,17 L52,6 L60,14 L68,4 L76,16 L84,8 L92,12 L100,10 L200,10"
                    ></path>
                </svg>
            </div>

            <section class="experience-section" id="experience">
                <div class="wide-column">
                    <h2>Real trails, brought indoors</h2>
                    <div class="experience-grid">
                        {
                            experienceItems.map((item) => (
                                <article class="feature">
                                    <div aria-hidden="true" />
                                    <h3>{item.title}</h3>
                                    <p>{item.body}</p>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="audience-section" id="audience">
                <div class="wide-column">
                    <h2>Who Trailwalk helps</h2>
                    <div class="audience-grid">
                        {
                            audiences.map((audience) => (
                                <article class="audience-card">
                                    <h3>{audience.title}</h3>
                                    <p>{audience.body}</p>
                                </article>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="faq-section" id="faq">
                <div class="wide-column">
                    <h2>Questions people ask</h2>
                    <div class="faq-list">
                        {
                            faqs.map((faq) => (
                                <details
                                    class="faq-item"
                                    data-trailwalk-faq={faq.analyticsId}
                                >
                                    <summary>{faq.question}</summary>
                                    <p>{faq.answer}</p>
                                </details>
                            ))
                        }
                    </div>
                </div>
            </section>

            <section class="contact-section" id="contact">
                <div class="contact-card">
                    <h2>Help shape what this becomes</h2>
                    <p class="body-copy">
                        Trailwalk is in its earliest stage with a working VR
                        prototype. We are inviting older adults,
                        caregivers, accessibility partners, community programs,
                        and anyone generally interested in accessible nature to
                        shape what the product becomes next.
                    </p>
                    <div class="contact-actions">
                        <a
                            class="button button-primary"
                            href="/contact/"
                            data-umami-event="trailwalk_cta_click"
                            data-umami-event-cta="request_demo_or_feedback"
                            data-umami-event-placement="contact"
                        >
                            Request a demo or share feedback
                        </a>
                        <a
                            class="button button-secondary"
                            href="#stay-in-the-loop"
                            data-umami-event="trailwalk_cta_click"
                            data-umami-event-cta="follow_updates"
                            data-umami-event-placement="contact"
                        >
                            Follow prototype updates
                        </a>
                    </div>
                </div>
            </section>

            <section class="loop-section" id="stay-in-the-loop">
                <svg
                    class="contours loop-contours"
                    viewBox="0 0 1440 500"
                    preserveAspectRatio="none"
                    fill="none"
                    aria-hidden="true"
                >
                    <path d="M-50,80 C300,60 600,130 900,95 S1300,55 1500,105"
                    ></path>
                    <path
                        d="M-50,220 C200,200 500,270 800,240 S1200,195 1500,250"
                    ></path>
                    <path
                        d="M-50,370 C250,355 550,410 850,385 S1250,350 1500,395"
                    ></path>
                </svg>
                <div class="loop-inner">
                    <h2>Stay in the loop</h2>
                    <p>
                        Trail captures, demo invitations, research notes, and
                        community updates.
                    </p>
                    <div class="loop-actions" aria-label="Trailwalk updates">
                        {updatesEmailHref && (
                            <a
                                class="button button-light"
                                href={updatesEmailHref}
                                data-umami-event="trailwalk_cta_click"
                                data-umami-event-cta="request_updates"
                                data-umami-event-placement="stay_in_loop"
                            >
                                Request updates
                            </a>
                        )}
                        {updateHref && (
                            <a
                                class="button button-ghost"
                                href={updateHref}
                                data-umami-event="trailwalk_cta_click"
                                data-umami-event-cta="development_notes"
                                data-umami-event-placement="stay_in_loop"
                            >
                                See development in action
                            </a>
                        )}
                    </div>
                    <p class="fine-print">
                        {contactEmail && updateLabel
                            ? `Email us for updates, or follow ${updateLabel} for development notes.`
                            : contactEmail
                              ? "Email us to request updates as the prototype progresses."
                              : updateLabel
                                ? `Follow ${updateLabel} for development notes.`
                                : "Development notes and updates are published as the prototype progresses."}
                    </p>
                </div>
            </section>
        </main>

        <footer class="trail-footer">
            <span>Trailwalk · {site.name}</span>
            {
                deployment.analytics.enabled && (
                    <span class="trail-footer__tracker">
                        Privacy-friendly analytics measure page visits and demo interest.
                    </span>
                )
            }
            {
                commitUrl ? (
                    <a class="trail-footer__build" href={commitUrl}>
                        Build {build.version}
                    </a>
                ) : (
                    <span class="trail-footer__build">Local build</span>
                )
            }
        </footer>
        <script>
            const trackTrailwalkEvent = (
                name: string,
                data: Record<string, string>,
            ) => {
                const umami = (
                    window as Window & {
                        umami?: {
                            track?: (
                                eventName: string,
                                data?: Record<string, string>,
                            ) => void;
                        };
                    }
                ).umami;

                umami?.track?.(name, data);
            };

            document
                .querySelectorAll<HTMLDetailsElement>("[data-trailwalk-faq]")
                .forEach((details) => {
                    details.addEventListener("toggle", () => {
                        trackTrailwalkEvent("trailwalk_faq_toggle", {
                            question: details.dataset.trailwalkFaq ?? "unknown",
                            state: details.open ? "open" : "close",
                        });
                    });
                });

            const heroVideo =
                document.querySelector<HTMLVideoElement>(".hero-video");

            if (heroVideo && "IntersectionObserver" in window) {
                let tracked = false;
                const observer = new IntersectionObserver(
                    (entries) => {
                        const entry = entries.find(
                            (entry) => entry.target === heroVideo,
                        );

                        if (!entry || !entry.isIntersecting || tracked) {
                            return;
                        }

                        tracked = true;
                        observer.disconnect();
                        trackTrailwalkEvent("trailwalk_hero_video_seen", {
                            muted: String(heroVideo.muted),
                            autoplay: String(heroVideo.autoplay),
                        });
                    },
                    { threshold: 0.35 },
                );

                observer.observe(heroVideo);
            }
        </script>
    </body>
</html>

<style is:global>
    :root {
        --tw-bg: #f8f5ef;
        --tw-bg-alt: #f2efe9;
        --tw-text: #2c2b28;
        --tw-secondary: #6b6860;
        --tw-tertiary: #9b9488;
        --tw-forest: #2e5e3e;
        --tw-forest-hover: #24502f;
        --tw-lake: #3b7a8a;
        --tw-divider: #e2ddd4;
        --tw-wave: #d4cfc4;
        --tw-dark: #1c3728;
        --tw-darkest: #0e1f16;
        --tw-footer: #152b1f;
        --tw-sand: #ebe6db;
        --tw-serif: "Lora", Georgia, serif;
        --tw-sans:
            "DM Sans", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        --tw-section-y: clamp(80px, 10vw, 148px);
        --tw-section-x: clamp(32px, 8vw, 160px);
    }

    * {
        box-sizing: border-box;
    }

    html {
        background: var(--tw-bg);
        scroll-behavior: smooth;
    }

    body {
        margin: 0;
        background: var(--tw-bg);
        color: var(--tw-text);
        font-family: var(--tw-sans);
        zoom: 1.25;
        -webkit-font-smoothing: antialiased;
    }

    a {
        color: var(--tw-forest);
        text-decoration: none;
    }

    a:hover {
        color: #3a7a4f;
    }

    .accent-bar {
        height: 3px;
        background: linear-gradient(
            90deg,
            var(--tw-forest) 0%,
            var(--tw-lake) 100%
        );
    }

    .page-nav {
        position: sticky;
        top: 0;
        z-index: 20;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        min-height: 64px;
        padding: 0 var(--tw-section-x);
        border-bottom: 1px solid rgba(226, 221, 212, 0.72);
        background: rgba(248, 245, 239, 0.92);
        backdrop-filter: blur(16px);
    }

    .nav-identity {
        display: inline-flex;
        flex: 0 0 auto;
        min-width: 0;
        align-items: center;
        gap: 12px;
        white-space: nowrap;
    }

    .nav-home {
        order: 0;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--tw-tertiary);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .nav-home:hover {
        color: var(--tw-forest);
    }

    .nav-identity::after {
        order: 1;
        width: 1px;
        height: 20px;
        background: var(--tw-divider);
        content: "";
    }

    .nav-brand {
        order: 2;
        color: var(--tw-text);
        font-family: var(--tw-serif);
        font-size: 18px;
        font-weight: 500;
    }

    .page-nav__links {
        display: flex;
        min-width: 0;
        flex-wrap: wrap;
        justify-content: flex-end;
        gap: clamp(12px, 1.8vw, 28px);
    }

    .page-nav__links a {
        color: var(--tw-tertiary);
        font-size: 12px;
        font-weight: 700;
        letter-spacing: 0;
        text-transform: uppercase;
    }

    .page-nav__links a:hover {
        color: var(--tw-forest);
    }

    .mobile-nav {
        display: none;
        position: relative;
        flex: 0 0 auto;
        margin-left: auto;
    }

    .mobile-nav summary {
        display: inline-flex;
        min-height: 38px;
        width: 42px;
        align-items: center;
        justify-content: center;
        padding: 0;
        border: 1px solid var(--tw-divider);
        border-radius: 999px;
        background: rgba(248, 245, 239, 0.9);
        color: var(--tw-secondary);
        cursor: pointer;
        list-style: none;
    }

    .mobile-nav summary::-webkit-details-marker {
        display: none;
    }

    .mobile-nav__icon,
    .mobile-nav__icon::before,
    .mobile-nav__icon::after {
        display: block;
        width: 16px;
        height: 2px;
        border-radius: 999px;
        background: var(--tw-lake);
    }

    .mobile-nav__icon {
        position: relative;
    }

    .mobile-nav__icon::before,
    .mobile-nav__icon::after {
        content: "";
        position: absolute;
        left: 0;
    }

    .mobile-nav__icon::before {
        top: -5px;
    }

    .mobile-nav__icon::after {
        top: 5px;
