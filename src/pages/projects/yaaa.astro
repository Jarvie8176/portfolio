    flex-wrap: wrap;
    justify-content: flex-end;
    gap: clamp(12px, 1.8vw, 28px);
  }

  .nav-section {
    position: relative;
  }

  .page-nav__links a {
    padding: 1rem 0;
  }

  .nav-primary {
    display: inline-flex;
    align-items: center;
    min-height: var(--site-header-min);
  }

  .nav-subnav {
    position: absolute;
    top: calc(100% - 0.4rem);
    right: 50%;
    display: grid;
    min-width: 12rem;
    padding: 0.45rem;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: color-mix(in srgb, var(--paper) 98%, transparent);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--ink) 14%, transparent);
    opacity: 0;
    pointer-events: none;
    transform: translate(50%, -0.35rem);
    transition:
      opacity 140ms ease,
      transform 140ms ease;
  }

  .nav-section:hover .nav-subnav,
  .nav-section:focus-within .nav-subnav {
    opacity: 1;
    pointer-events: auto;
    transform: translate(50%, 0);
  }

  .nav-subnav a {
    min-height: 2.25rem;
    padding: 0.72rem 0.85rem;
    border-radius: 6px;
    font-size: 0.68rem;
    line-height: 1;
    white-space: nowrap;
  }

  .nav-subnav a:hover {
    background: color-mix(in srgb, var(--systems) 8%, transparent);
  }

  .nav-home:hover,
  .nav-brand:hover,
  .page-nav__links a:hover,
  .mobile-nav nav a:hover {
    color: var(--systems);
  }

  .nav-home:focus-visible,
  .nav-brand:focus-visible,
  .page-nav__links a:focus-visible,
  .mobile-nav summary:focus-visible,
  .mobile-nav nav a:focus-visible {
    outline: 2px solid var(--systems);
    outline-offset: 4px;
  }

  .mobile-nav {
    display: none;
    position: relative;
    flex: 0 0 auto;
    margin-left: auto;
  }

  .mobile-nav summary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    min-height: 38px;
    padding: 0;
    border: 1px solid var(--rule);
    border-radius: 999px;
    background: color-mix(in srgb, var(--paper) 90%, transparent);
    cursor: pointer;
    list-style: none;
  }

  .mobile-nav summary::-webkit-details-marker {
    display: none;
  }

  .mobile-nav__icon,
  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    display: block;
    width: 16px;
    height: 2px;
    border-radius: 999px;
    background: var(--systems);
    content: "";
  }

  .mobile-nav__icon {
    position: relative;
  }

  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    position: absolute;
    left: 0;
  }

  .mobile-nav__icon::before {
    top: -5px;
  }

  .mobile-nav__icon::after {
    top: 5px;
  }

  .mobile-nav[open] .mobile-nav__icon {
    background: transparent;
  }

  .mobile-nav[open] .mobile-nav__icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .mobile-nav[open] .mobile-nav__icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-nav nav {
    position: absolute;
    right: 0;
    top: calc(100% + 10px);
    display: grid;
    gap: 0.25rem;
    width: min(76vw, 280px);
    max-height: min(70vh, 34rem);
    padding: 8px;
    overflow-y: auto;
    border: 1px solid var(--rule);
    border-radius: 8px;
    background: color-mix(in srgb, var(--paper) 98%, transparent);
    box-shadow: 0 18px 42px color-mix(in srgb, var(--ink) 14%, transparent);
  }

  .mobile-nav-group {
    display: grid;
    gap: 0.1rem;
    padding: 0.25rem 0;
    border-top: 1px solid var(--rule);
  }

  .mobile-nav-group:first-child {
    border-top: 0;
  }

  .mobile-nav nav a {
    display: block;
    min-height: 36px;
    padding: 11px 14px;
    border-radius: 6px;
    color: var(--ink-soft);
    line-height: 1;
    white-space: nowrap;
  }

  .mobile-nav .mobile-nav-group-label {
    color: var(--ink);
  }

  .mobile-nav-children {
    display: grid;
    padding-left: 0.75rem;
  }

  .mobile-nav-children a {
    min-height: 30px;
    padding-block: 8px;
    color: var(--ink-faint);
    font-size: 0.66rem;
  }

  .mobile-nav nav a:hover {
    background: color-mix(in srgb, var(--systems) 8%, transparent);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* ---------- shared micro-type ---------- */

  .eyebrow,
  .stack-title,
  .subsystem-stack b,
  .section-label,
  .kicker,
  .example-label,
  .role-key b,
  .flow-list b,
  .case-grid header span,
  .problem-label,
  .compare-label,
  .back-link {
    font-family: var(--mono);
    font-size: 0.72rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h1,
  h2,
  h3,
  p,
  dd {
    overflow-wrap: anywhere;
  }

  /* ---------- hero ---------- */

  .hero {
    min-height: calc(100svh - var(--site-header-min));
    display: grid;
    grid-template-columns: minmax(18rem, 1fr) minmax(17rem, 0.62fr);
    align-items: center;
    gap: clamp(2rem, 5vw, 5rem);
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 6rem) var(--pad);
  }

  .hero-copy {
    min-width: 0;
  }

  .eyebrow {
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    color: var(--ink-faint);
  }

  h1 {
    max-width: 50rem;
    margin: 0.75rem 0 0;
    font-family: var(--sans);
    font-size: clamp(4rem, 12vw, 8.4rem);
    font-weight: 800;
    letter-spacing: 0;
    line-height: 0.86;
  }

  .hero-subtitle {
    max-width: 39rem;
    margin: clamp(1.2rem, 2.6vw, 2rem) 0 0;
    color: var(--embodied);
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3.2vw, 2.35rem);
    font-style: italic;
    line-height: 1.1;
  }

  .summary {
    max-width: 39rem;
    margin: clamp(1.4rem, 3vw, 2.2rem) 0 0;
    font-size: clamp(1.05rem, 1.5vw, 1.28rem);
    line-height: 1.7;
  }

  .framework-note {
    max-width: 39rem;
    margin: 1.35rem 0 0;
    padding-left: 1rem;
    border-left: 2px solid var(--systems);
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.65;
  }

  .framework-note a {
    color: var(--systems);
    font-weight: 700;
    text-underline-offset: 0.18em;
  }

  /* ---------- hero subsystem stack ---------- */

  .subsystem-stack {
    position: relative;
    margin: 0;
    min-width: 0;
    padding: clamp(1.25rem, 2vw, 1.75rem);
    border: 1px solid var(--rule-hard);
    border-radius: 4px;
    background:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--systems) 4%, transparent) 0 1px,
        transparent 1px 28px
      ),
      var(--surface);
  }

  .subsystem-stack::before {
    content: "";
    position: absolute;
    inset: -0.85rem 0.85rem 0.85rem -0.85rem;
    border: 1px solid color-mix(in srgb, var(--systems) 36%, transparent);
    border-radius: 4px;
    pointer-events: none;
  }

  .stack-title {
    color: var(--stamp);
  }

  .subsystem-stack ul {
    position: relative;
    margin: 1.1rem 0 0;
    padding: 0 0 0 1.1rem;
    list-style: none;
  }

  /* the binding bus */
  .subsystem-stack ul::before {
    content: "";
    position: absolute;
    top: 0.75rem;
    bottom: 0.75rem;
    left: 0;
    border-left: 2px solid var(--systems);
  }

  .subsystem-stack li {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.55rem;
    min-width: 0;
    margin-top: 0.5rem;
    padding: 0.6rem 0.75rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--paper);
  }

  .subsystem-stack li:first-child {
    margin-top: 0;
  }

  /* connector stub from bus to subsystem */
  .subsystem-stack li::before {
    content: "";
    position: absolute;
    top: 50%;
    left: -1.1rem;
    width: 1.1rem;
    border-top: 1px solid var(--systems);
  }

  .subsystem-stack b {
    color: var(--ink);
  }

  .subsystem-stack figcaption {
    margin-top: 1rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }

  /* ---------- spine ---------- */

  .spine-wrap {
    position: relative;
  }

  .spine-wrap::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(max((100% - var(--page-max)) / 2, 0px) + var(--pad) + 0.95rem);
    border-left: 1px solid var(--rule-hard);
  }

  .page-section {
    position: relative;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: clamp(3.5rem, 7vw, 5.8rem) var(--pad) clamp(3.5rem, 7vw, 5.8rem)
      calc(var(--pad) + var(--spine-gap));
    border-top: 1px solid var(--rule);
  }

  .section-label {
    display: flex;
    align-items: center;
    gap: 1.1rem;
    margin: 0 0 clamp(1.5rem, 3vw, 2.4rem) calc(-1 * var(--spine-gap));
    color: var(--ink-faint);
  }

  .sec-no {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border: 1px solid var(--systems);
    border-radius: 3px;
    background: var(--paper);
    color: var(--systems);
  }

  .section-label h2 {
    margin: 0;
    color: inherit;
    font-family: inherit;
    font-size: inherit;
    font-weight: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
  }

  /* ---------- body copy ---------- */

  .lead {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.55rem, 3vw, 2.45rem);
    font-weight: 500;
    line-height: 1.18;
  }

  .concept-grid p,
  .formula-note,
  .stance-note,
  .policy-note,
  .flow-list,
  .case-grid p,
  .problem-grid p,
  .problem-response,
  .compare-grid p,
  .compare-note,
  .layer-text p,
  .question-list p {
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.72;
  }

  .concept-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }

  .concept-grid > div {
    padding-top: 1.35rem;
    border-top: 1px solid var(--rule-hard);
  }

  .kicker {
    margin: 0;
    color: var(--systems);
  }

  .concept-grid h3,
  .case-grid h3 {
    margin: 0.65rem 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .concept-grid p:not(.kicker) {
    margin: 0.9rem 0 0;
  }

  /* ---------- problem: intro + 3 columns + response ---------- */

  .problem-intro {
    max-width: 52rem;
    margin: 0;
    font-size: clamp(1.35rem, 2.2vw, 1.85rem);
    line-height: 1.32;
  }

  .problem-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    border: 1px solid var(--rule-hard);
    border-radius: 4px;
    overflow: hidden;
    background: var(--rule-hard);
  }

  .problem-grid article {
    min-width: 0;
    padding: clamp(1.25rem, 2.3vw, 2rem);
    background: var(--surface);
  }

  .problem-card-visual {
    margin: 0 0 1rem;
  }

  .problem-card-visual svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .problem-label {
    color: var(--systems);
  }

  .problem-grid p {
    margin: 0.75rem 0 0;
  }

  .problem-response {
    max-width: 52rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-left: 1.15rem;
    border-left: 3px solid var(--systems);
  }

  /* ---------- problem concept diagram ---------- */

  .problem-figure {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .problem-figure svg {
    display: block;
    width: 100%;
    max-width: 33rem;
    height: auto;
    margin-inline: auto;
  }

  .problem-figure figcaption {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.78rem;
    text-align: center;
  }

  .problem-figure text { font-family: var(--mono); }
  .pf-chip { fill: none; stroke: var(--ink-faint); stroke-width: 1; }
  .pf-chip-t { fill: var(--ink-soft); font-size: 9.5px; }
  .pf-line { stroke: var(--ink-faint); stroke-width: 1; opacity: 0.5; }
  .pf-box { fill: var(--surface); stroke: var(--ink); stroke-width: 1.8; }
  .pf-box-t { fill: var(--ink); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; }
  .pf-eye { fill: none; stroke: var(--ink); stroke-width: 1.4; }
  .pf-pupil { fill: var(--ink); }
  .pf-arr-h { fill: var(--ink); }
  .pf-out { fill: none; stroke: var(--ink); stroke-width: 2.2; }
  .pf-faint { fill: var(--ink-faint); font-size: 9px; }
  .pf-block { fill: none; stroke: #d97706; stroke-width: 1.6; stroke-dasharray: 5 4; }
  .pf-x { fill: none; stroke: #d97706; stroke-width: 2; }
  .pf-block-t { fill: #d97706; font-size: 9.5px; font-weight: 700; }
  .pr-box { fill: color-mix(in srgb, var(--systems) 6%, var(--surface)); stroke: var(--systems); stroke-width: 1.8; }
  .pr-box-t { fill: var(--systems); font-size: 11px; font-weight: 700; letter-spacing: 0.04em; }
  .pr-glyph { fill: none; stroke: var(--systems); stroke-width: 1.6; }
  .pr-arr-h { fill: var(--systems); }
  .pr-out { fill: none; stroke: var(--systems); stroke-width: 2; }
  .pr-out-thin { fill: none; stroke: var(--systems); stroke-width: 1.4; }
  .pr-label { fill: var(--systems); font-size: 9px; font-weight: 700; }
  .pc-chip { fill: var(--paper); stroke: var(--ink-faint); stroke-width: 1; }
  .pc-box { fill: var(--surface); stroke: var(--ink-faint); stroke-width: 1.2; }
  .pc-danger { stroke: #d97706; }
  .pc-line { fill: none; stroke: var(--ink-soft); stroke-width: 1.2; }
  .pc-heavy { stroke-width: 1.8; }
  .pc-dashed { stroke-dasharray: 4 3; }
  .pc-arrow { fill: var(--ink-soft); }
  .pc-text { fill: var(--ink-soft); font-family: var(--mono); font-size: 7.5px; }
  .pc-strong { fill: var(--ink); font-family: var(--mono); font-size: 8.5px; font-weight: 800; }
  .pc-note { fill: var(--ink-faint); font-family: var(--mono); font-size: 7px; }
  .pc-eye,
  .pc-warn { fill: none; stroke: #d97706; stroke-width: 1.4; }
  .pc-dot { fill: #d97706; }

  /* ---------- LLMOps contrast ---------- */

  .compare {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .compare-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 0.9rem 0 0;
    border: 1px solid var(--rule-hard);
    border-radius: 4px;
    overflow: hidden;
    background: var(--rule-hard);
  }

  .compare-grid article {
    min-width: 0;
    padding: clamp(1.25rem, 2.3vw, 2rem);
    background: var(--surface);
  }

  .compare-label {
    color: var(--ink-faint);
  }

  .compare-label-accent {
    color: var(--systems);
  }

  .compare-grid p {
    margin: 0.6rem 0 0;
  }

  .compare-note {
    max-width: 52rem;
    margin: 1rem 0 0;
    padding-left: 1.15rem;
    border-left: 3px solid var(--systems);
  }

  /* ---------- formula ---------- */

  .formula {
    display: grid;
    gap: 0.4rem;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding: clamp(1.25rem, 2.3vw, 2rem);
    border: 1px solid var(--rule-hard);
    border-radius: 4px;
    background:
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, var(--systems) 4%, transparent) 0 1px,
        transparent 1px 28px
      ),
      var(--surface);
    font-family: var(--mono);
    font-size: clamp(0.8rem, 1.1vw, 0.95rem);
    line-height: 1.6;
    color: var(--ink);
  }

  .formula span:last-child {
    margin-top: 0.35rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--rule-hard);
    color: var(--systems);
    font-weight: 700;
  }

  .formula-note {
    max-width: 47rem;
    margin: 1.35rem 0 0;
  }

  .stance-note {
    max-width: 47rem;
    margin: 1rem 0 0;
  }

  /* ---------- per-layer sub-sections ---------- */

  .layer-stack {
    margin: clamp(1.5rem, 3vw, 2.4rem) 0 0;
  }

  .layer-drill-intro {
    max-width: 58rem;
    margin: clamp(2rem, 4vw, 3rem) 0 0;
    padding-top: clamp(1.4rem, 2.5vw, 2rem);
    border-top: 1px solid var(--rule-hard);
  }

  .layer-drill-intro h3 {
    margin: 0.65rem 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.45rem, 2vw, 2rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.15;
  }

  .layer-drill-intro p:not(.example-label) {
    margin: 0.9rem 0 0;
    color: var(--ink-soft);
    font-size: clamp(1rem, 1.25vw, 1.12rem);
    line-height: 1.72;
  }

  .layer-block {
    padding: clamp(1.4rem, 3vw, 2rem) 0;
    border-top: 1px solid var(--rule);
  }

  .layer-block:first-child {
    border-top: 0;
    padding-top: 0.25rem;
  }

  .layer-head {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.2rem, 1.7vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0;
    color: var(--ink);
  }

  .layer-code {
    flex: none;
    padding: 0.12rem 0.4rem;
    border: 1px solid color-mix(in srgb, var(--lc, var(--systems)) 45%, transparent);
    border-radius: 3px;
    font-family: var(--mono);
    font-size: 0.7rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    color: var(--lc, var(--systems));
    transform: translateY(-0.12em);
  }

  .layer-text p {
    margin: 0 0 0.85rem;
    max-width: 54rem;
  }

  .layer-legend {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.7rem 1.5rem;
    margin: 1.1rem 0 0;
  }

  .layer-legend div {
    min-width: 0;
  }

  .layer-legend dt {
    font-family: var(--mono);
    font-size: 0.74rem;
    font-weight: 700;
    color: var(--ink);
  }

  .layer-legend dd {
    margin: 0.15rem 0 0;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--ink-soft);
  }

  .layer-block.L0 { --lc: #2f855a; }
  .layer-block.L1 { --lc: #0e7490; }
  .layer-block.L2 { --lc: #334155; }
  .layer-block.L3 { --lc: #7c3aed; }
  .layer-block.L4 { --lc: #d97706; }
  .layer-block.L5 { --lc: #334155; }

  .layer-body {
    display: grid;
    grid-template-columns: 1fr minmax(180px, 230px);
    gap: clamp(1.5rem, 3vw, 2.5rem);
    align-items: start;
    margin-top: 0.9rem;
  }

  .layer-block.wide .layer-body {
    grid-template-columns: 1fr;
  }

  .layer-mini { margin: 0; }
  .layer-block.wide .layer-mini {
    width: 100%;
    max-width: 58rem;
    margin-top: 1rem;
    margin-inline: auto;
    overflow-x: auto;
  }
  .layer-mini svg { display: block; width: 100%; height: auto; }
  .layer-block.wide .layer-mini svg { min-width: 38rem; }

  .mini-cap {
    margin: 0.5rem 0 0;
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--ink-faint);
    text-align: center;
  }

  .m-box { fill: var(--surface); stroke: var(--lc); stroke-width: 1.5; }
  .m-auth { stroke-width: 2.6; }
  .m-proj { stroke-dasharray: 4 3; }
  .m-line { fill: none; stroke: var(--lc); stroke-width: 1.4; }
  .m-h { fill: var(--lc); }
  .m-t { fill: var(--ink); font-family: var(--mono); font-size: 8px; font-weight: 600; }

  .arch-map {
    margin: 0 0 clamp(1.5rem, 3vw, 2.4rem);
  }

  .arch-map figcaption {
    margin-top: 0.75rem;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.78rem;
    line-height: 1.5;
  }

