---
import Base from '../../layouts/Base.astro';
import { site } from '../../data/site';
import ProjectDiagram from '../../components/diagram/ProjectDiagram.astro';
import SectionDotNav from '../../components/SectionDotNav.astro';
import yaaaCanvas from '../../diagrams/yaaa.canvas?raw';

const formulaLines = [
  'federated subsystems',
  '+ user-owned memory',
  '+ local-first routing',
  '+ gated action',
  '+ reviewed governance',
  '= a personal assistant ops architecture',
];

const stackRows = [
  { name: 'Sense' },
  { name: 'Remember' },
  { name: 'Reason' },
  { name: 'Converse' },
  { name: 'Act' },
  { name: 'Surface' },
];

const layerSummaries = [
  {
    code: 'L0',
    name: 'IO boundary',
    text:
      'Names how outside events enter and how approved outputs leave: passive input, proactive input, passive output, and proactive output.',
  },
  {
    code: 'L1',
    name: 'SENSE',
    text:
      'Turns available context from adapters into source records with a unified shape and preserved provenance.',
  },
  {
    code: 'L2',
    name: 'Binding layer',
    text:
      'Binds memory authority, local-first mode routing, model/tool choice, and the replaceable Converse surface.',
  },
  {
    code: 'L3',
    name: 'Bounded ReAct',
    text:
      'Runs the task loop under L2 context and returns observations or an intent proposal, never direct writes.',
  },
  {
    code: 'L4',
    name: 'Gated action',
    text:
      'Converts side-effect intent into approve, refuse, or defer through one policy-checked write boundary.',
  },
  {
    code: 'L5',
    name: 'Governance foundation',
    text:
      'Turns run traces into reviewed memory, SOP, ADR, runbook, manifest, or policy changes for future runs.',
  },
];

const tradeoffCorners = [
  {
    label: 'Capability + ecosystem reach',
    note: 'deep integrations, broad context, cloud-scale tools',
  },
  {
    label: 'Frictionless speed',
    note: 'instant answers, low-latency automation, fewer confirmations',
  },
  {
    label: 'Owned + auditable control',
    note: 'local-first routing, reviewable memory, gated side effects',
  },
];

const challengeItems = [
  {
    id: 'limit-approval-friction',
    question: 'How much friction does safety add?',
    answer: [
      'Yaaa gates outside-world side effects, not every answer. Reading, drafting, and local reasoning can stay fast; L4 is reserved for actions that send, change, spend, publish, or otherwise affect the world. Stable low-risk procedures can graduate into narrow policy grants, where the gate records an approve_by_policy disposition instead of asking every time.',
      'High-risk or ambiguous actions still slow down. A sensitive action that cannot name its target, account, permission, confirmation, and rollback path should defer or refuse instead of running by accident.',
    ],
  },
  {
    id: 'limit-latency',
    question: 'Where is Yaaa intentionally slow?',
    answer: [
      'The slow path is the sensitive path: provenance-preserving ingestion, local model routing, side-effect review, and later governance. L0-L5 are authority boundaries, not one mandatory synchronous chain; passive input can be sensed ahead of time, L5 runs after the task, and low-risk reads can use a shorter route.',
      'Yaaa is a poor fit for millisecond-critical experiences such as live translation or always-on voice control. Local hardware, adapter quality, review steps, and retention budgets set real speed limits.',
    ],
  },
  {
    id: 'limit-memory',
    question: 'Can natural-language memory really be reconciled?',
    answer: [
      'Runtime memory should live where runtime systems are good at it: Postgres for source records, traces, working memory, and queues; vector indexes for retrieval; harness and agent memory for local recall. The git-backed SSoT holds reviewed authority: core memory, SOPs, ADRs, policies, and procedure manifests.',
      'LLM-assisted reconciliation can explain diffs and propose candidate patches, but the model is not the judge. Semantic conflicts still need policy or human review before one version becomes authority.',
    ],
  },
  {
    id: 'limit-data-silos',
    question: 'What happens when a data source is closed?',
    answer: [
      'SENSE treats adapters as graded capabilities: official APIs and exports first, local files, webhooks, RSS, and manual capture next, with RPA or OCR only as a fragile fallback. Missing sources stay explicit, so the assistant can say what it knows and what it cannot see.',
      'Closed ecosystems remain closed. RPA can help the system see, but it is slow, brittle, less auditable, and vulnerable to UI or platform changes, so it should not become a high-trust source.',
    ],
  },
  {
    id: 'limit-ops-overhead',
    question: 'Who is willing to operate this?',
    answer: [
      'The operator should not live in YAML. Yaaa needs opinionated default policy sets, plain-language review queues, and one-click promotions for stable lessons. L5 should turn traces into simple decisions, such as whether a repeated calendar pattern should become a default rule.',
      'This remains a self-hostable architecture for operators and power users first. A zero-admin consumer assistant is a different product boundary, and some maintenance burden is part of the bargain.',
    ],
  },
];

const appointmentIntentYaml = `intent_type: reschedule_appointment
proposal_only: true
requested_by: operator
target:
  calendar_event_id: evt_123
  recipient_ref: provider_office
  account_ref: personal_calendar
proposed_change:
  from: '2026-08-19T10:00:00-07:00'
  to: '2026-08-20T15:00:00-07:00'
  message_draft: 'Ask whether the new time is available.'
policy_context:
  mode: personal_sensitive
  model_route: local
  required_confirmation: operator_approval
provenance:
  - calendar_event
  - appointment_email`;

const escapeHtml = (value: string) =>
  value
    .replaceAll('&', '&amp;')
    .replaceAll('<', '&lt;')
    .replaceAll('>', '&gt;')
    .replaceAll('"', '&quot;');

const highlightYamlValue = (value: string) => {
  if (!value.trim()) return '';
  const leading = value.match(/^\s*/)?.[0] ?? '';
  const scalar = value.trim();
  const cls =
    /^(true|false|null)$/.test(scalar)
      ? 'yaml-bool'
      : /^['"].*['"]$/.test(scalar)
        ? 'yaml-string'
        : 'yaml-scalar';

  return `${leading}<span class="${cls}">${escapeHtml(scalar)}</span>`;
};

const highlightedAppointmentIntentYaml = appointmentIntentYaml
  .split('\n')
  .map((line) => {
    const listMatch = line.match(/^(\s*)-\s+(.+)$/);
    if (listMatch) {
      return `${listMatch[1]}<span class="yaml-list">-</span> ${highlightYamlValue(listMatch[2])}`;
    }

    const kvMatch = line.match(/^(\s*)([A-Za-z_][\w-]*):(\s*)(.*)$/);
    if (kvMatch) {
      return `${kvMatch[1]}<span class="yaml-key">${kvMatch[2]}</span><span class="yaml-punct">:</span>${kvMatch[3]}${highlightYamlValue(kvMatch[4])}`;
    }

    return escapeHtml(line);
  })
  .join('\n');

const appointmentSteps = [
  {
    layer: 'L0',
    title: 'The operator asks for a change',
    body:
      'The request enters through proactive input with the calendar event and appointment message as context.',
    schema: ['requested_by', 'target.calendar_event_id', 'target.recipient_ref'],
  },
  {
    layer: 'L1',
    title: 'SENSE normalizes the context',
    body:
      'Calendar and email adapters become source records, so later reasoning can point back to what was actually seen.',
    schema: ['provenance'],
  },
  {
    layer: 'L2',
    title: 'Binding chooses the safe route',
    body:
      'The policy router treats this as personal-sensitive work, selects a local route, and Converse packages the turn.',
    schema: ['policy_context.mode', 'policy_context.model_route'],
  },
  {
    layer: 'L3',
    title: 'ReAct proposes intent only',
    body:
      'The task loop drafts a new time and a message, but the artifact is still only a proposal for L4.',
    schema: ['proposal_only', 'proposed_change.from', 'proposed_change.to', 'proposed_change.message_draft'],
  },
  {
    layer: 'L4',
    title: 'The gate checks the manifest',
    body:
      'L4 verifies target, account, sensitivity, policy, and required confirmation before it may approve, refuse, or defer.',
    schema: ['target.account_ref', 'policy_context.required_confirmation'],
  },
  {
    layer: 'L5',
    title: 'Governance keeps the lesson reviewable',
    body:
      'The run trace can later support a reviewed runbook, policy, or manifest change that feeds future runs.',
    schema: ['intent_type', 'provenance'],
  },
];

const sectionNavItems = [
  {
    id: 'problem',
    label: 'Problem',
    accent: 'systems',
    children: [],
  },
  {
    id: 'concept',
    label: 'Concept',
    accent: 'embodied',
    children: [
      { id: 'concept-boundary', label: 'Definition' },
      { id: 'concept-formula', label: 'Formula' },
      { id: 'concept-rationale', label: 'Rationale' },
    ],
  },
  {
    id: 'how-it-works',
    label: 'Architecture',
    accent: 'systems',
    children: [
      { id: 'architecture-rationale', label: 'Two loops' },
      { id: 'architecture-map', label: 'System map' },
      { id: 'architecture-example', label: 'Example' },
    ],
  },
  {
    id: 'architecture-layers',
    label: 'Layers',
    accent: 'systems',
    children: layerSummaries.map((layer) => ({
      id: `layer-${layer.code.toLowerCase()}`,
      label: `${layer.code} ${layer.name}`,
    })),
  },
  {
    id: 'design-invariants',
    label: 'Invariants',
    accent: 'systems',
    children: [
      { id: 'invariant-memory', label: 'Memory' },
      { id: 'invariant-decisions', label: 'Decisions' },
      { id: 'invariant-actions', label: 'Actions' },
    ],
  },
  {
    id: 'challenges-limits',
    label: 'Limits',
    accent: 'muted',
    children: [],
  },
];

const dotNavItems = [
  { id: 'intro', label: 'Intro', accent: 'ink' },
  ...sectionNavItems.map(({ id, label, accent }) => ({ id, label, accent })),
];
---

<Base
  title={`${site.name} · Yaaa`}
  description="Yaaa (Yet Another AI Assistant) is a personal assistant ops architecture: a personal AI assistant assembled as a federation of small, auditable systems instead of a monolithic black box."
  ogType="article"
  wide
  showHeader={false}
>
  <header class="page-nav" aria-label="Yaaa navigation">
    <div class="nav-identity">
      <a
        class="nav-home"
        href="/#yaaa"
        aria-label="Back to work index"
        data-umami-event="yaaa_nav_click"
        data-umami-event-section="work_index"
        data-umami-event-placement="header"
      >
        <span aria-hidden="true">←</span>
        <span>Portfolio</span>
      </a>
      <a
        class="nav-brand"
        href="#intro"
        aria-current="page"
        data-umami-event="yaaa_nav_click"
        data-umami-event-section="hero"
        data-umami-event-placement="header"
      >
        YAAA
      </a>
    </div>
    <nav class="page-nav__links" aria-label="Yaaa page sections">
      {sectionNavItems.map((item) => (
        <div class="nav-section">
          <a
            class="nav-primary"
            href={`#${item.id}`}
            data-umami-event="yaaa_nav_click"
            data-umami-event-section={item.id}
            data-umami-event-placement="header"
          >
            {item.label}
          </a>
          {item.children.length > 0 && (
            <div class="nav-subnav" aria-label={`${item.label} subsections`}>
              {item.children.map((child) => (
                <a
                  href={`#${child.id}`}
                  data-umami-event="yaaa_nav_click"
                  data-umami-event-section={child.id}
                  data-umami-event-placement="header_subnav"
                >
                  {child.label}
                </a>
              ))}
            </div>
          )}
        </div>
      ))}
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Yaaa sections">
        <span class="mobile-nav__icon" aria-hidden="true"></span>
        <span class="sr-only">Sections</span>
      </summary>
      <nav aria-label="Yaaa mobile sections">
        {sectionNavItems.map((item) => (
          <div class="mobile-nav-group">
            <a
              class="mobile-nav-group-label"
              href={`#${item.id}`}
              data-umami-event="yaaa_nav_click"
              data-umami-event-section={item.id}
              data-umami-event-placement="mobile_menu"
            >
              {item.label}
            </a>
            {item.children.length > 0 && (
              <div class="mobile-nav-children">
                {item.children.map((child) => (
                  <a
                    href={`#${child.id}`}
                    data-umami-event="yaaa_nav_click"
                    data-umami-event-section={child.id}
                    data-umami-event-placement="mobile_subnav"
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            )}
          </div>
        ))}
      </nav>
    </details>
  </header>
  <SectionDotNav items={dotNavItems} />
  <main class="yaaa-page">
    <section class="hero" id="intro" aria-labelledby="project-title">
      <div class="hero-copy">
        <p class="eyebrow">Personal assistant ops architecture</p>
        <h1 id="project-title">YAAA</h1>
        <p class="hero-subtitle">an assistant you actually own</p>
        <p class="summary">
          Yaaa (Yet Another AI Assistant) is a personal assistant ops
          architecture: a self-hostable, local-first system where memory,
          routing, and every action stay versioned, reviewed, and owned by you.
          Sensitive work runs local; cloud and model use is bounded by mode
          routing and leak checks that keep sensitive context off disallowed
          routes, and side effects leave through one fail-closed gate.
          Conversation harnesses can be replaced without moving the source of
          truth.
        </p>
        <p class="framework-note">
          <a href="/projects/amanuensis/">Amanuensis</a> is one concrete
          implementation within this framework, supplying reasoning, converse,
          and attention-aware delivery subsystems for information triage. Yaaa
          defines the ops architecture around those subsystems rather than
          replacing them with one application.
        </p>
      </div>

      <figure
        class="subsystem-stack"
        role="img"
        aria-label="Diagram of the Yaaa subsystems on a shared binding bus: sense, remember, reason, converse, act (intent proposal only), and surface"
      >
        <span class="stack-title">runtime subsystems</span>
        <ul>
          {stackRows.map((row) => (
            <li>
              <b>{row.name}</b>
            </li>
          ))}
        </ul>
        <figcaption>The subsystems on a shared binding bus.</figcaption>
      </figure>
    </section>

    <div class="spine-wrap">
      <section class="page-section" id="problem" aria-labelledby="problem-title">
        <div class="section-label">
          <span class="sec-no">01</span>
          <h2 id="problem-title">Problem</h2>
        </div>
        <p class="lead problem-intro">
          The more context a personal assistant needs, the more consequential
          its ownership boundary becomes.
        </p>
        <figure class="problem-figure" id="problem-risk-map" role="img" aria-label="Personal data streams, including mail, notes, calendar, camera, health, location, and chats, converge into an external cloud service; handling, retention, and recall then depend on provider terms.">
          <svg viewBox="0 0 560 262" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="pf-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                <path class="pf-arr-h" d="M0,0 L10,5 L0,10 z"/>
              </marker>
            </defs>
            <g aria-hidden="true">
              <line class="pf-line" x1="98" y1="27" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="59" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="91" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="123" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="155" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="187" x2="238" y2="130"/>
              <line class="pf-line" x1="98" y1="219" x2="238" y2="130"/>
              <rect class="pf-chip" x="6" y="16" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="31" text-anchor="middle">mail</text>
              <rect class="pf-chip" x="6" y="48" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="63" text-anchor="middle">notes</text>
              <rect class="pf-chip" x="6" y="80" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="95" text-anchor="middle">calendar</text>
              <rect class="pf-chip" x="6" y="112" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="127" text-anchor="middle">camera</text>
              <rect class="pf-chip" x="6" y="144" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="159" text-anchor="middle">health</text>
              <rect class="pf-chip" x="6" y="176" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="191" text-anchor="middle">location</text>
              <rect class="pf-chip" x="6" y="208" width="92" height="22" rx="4"/>
              <text class="pf-chip-t" x="52" y="223" text-anchor="middle">chats</text>
              <text class="pf-faint" x="52" y="250" text-anchor="middle">your data streams</text>
              <rect class="pf-box" x="240" y="88" width="140" height="84" rx="6"/>
              <ellipse class="pf-eye" cx="310" cy="112" rx="14" ry="8"/>
              <circle class="pf-pupil" cx="310" cy="112" r="3.6"/>
              <text class="pf-box-t" x="310" y="145" text-anchor="middle">external cloud</text>
              <text class="pf-box-t" x="310" y="161" text-anchor="middle">service</text>
              <line class="pf-out" x1="380" y1="124" x2="500" y2="124" marker-end="url(#pf-arr)"/>
              <text class="pf-faint" x="440" y="116" text-anchor="middle">sent out</text>
              <line class="pf-block" x1="500" y1="146" x2="388" y2="146"/>
              <text class="pf-block-t" x="443" y="170" text-anchor="middle">provider terms</text>
            </g>
          </svg>
          <figcaption>
            Once data leaves the user-owned boundary, control depends on
            provider terms.
          </figcaption>
        </figure>
        <div class="problem-grid" id="problem-failure-modes">
          <article>
            <figure class="problem-card-visual" role="img" aria-label="Multiple private sources cross into an external service, where downstream handling depends on provider terms.">
              <svg viewBox="0 0 240 104" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <marker id="pc-aggregate-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                    <path class="pc-arrow" d="M0,0 L10,5 L0,10 z"/>
                  </marker>
                </defs>
                <rect class="pc-chip" x="8" y="12" width="54" height="18" rx="4"/>
                <text class="pc-text" x="35" y="24" text-anchor="middle">mail</text>
                <rect class="pc-chip" x="8" y="43" width="54" height="18" rx="4"/>
                <text class="pc-text" x="35" y="55" text-anchor="middle">notes</text>
                <rect class="pc-chip" x="8" y="74" width="54" height="18" rx="4"/>
                <text class="pc-text" x="35" y="86" text-anchor="middle">life</text>
                <line class="pc-line" x1="62" y1="21" x2="103" y2="52" marker-end="url(#pc-aggregate-arr)"/>
                <line class="pc-line" x1="62" y1="52" x2="103" y2="52" marker-end="url(#pc-aggregate-arr)"/>
                <line class="pc-line" x1="62" y1="83" x2="103" y2="52" marker-end="url(#pc-aggregate-arr)"/>
                <rect class="pc-box pc-danger" x="108" y="27" width="64" height="50" rx="5"/>
                <text class="pc-strong" x="140" y="50" text-anchor="middle">external</text>
                <text class="pc-text" x="140" y="64" text-anchor="middle">service</text>
                <line class="pc-line pc-heavy" x1="172" y1="52" x2="219" y2="52" marker-end="url(#pc-aggregate-arr)"/>
                <text class="pc-note" x="201" y="82" text-anchor="middle">provider terms</text>
              </svg>
            </figure>
            <span class="problem-label">Context crosses a boundary</span>
            <p>
              To be useful, an assistant needs context other software only
              glimpses: identity, conversations, private notes, location, and
              sometimes legal or medical history. Sending that context across
              an external ownership boundary makes provider controls
              consequential, and a complete recall path may not be available.
            </p>
          </article>
          <article>
            <figure class="problem-card-visual" role="img" aria-label="Cloud routing places provider processing, logging, retention, moderation, and policy between the user and the assistant output.">
              <svg viewBox="0 0 240 104" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <marker id="pc-screen-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                    <path class="pc-arrow" d="M0,0 L10,5 L0,10 z"/>
                  </marker>
                </defs>
                <rect class="pc-chip" x="10" y="40" width="52" height="24" rx="5"/>
                <text class="pc-text" x="36" y="55" text-anchor="middle">prompt</text>
                <line class="pc-line" x1="62" y1="52" x2="92" y2="52" marker-end="url(#pc-screen-arr)"/>
                <rect class="pc-box pc-danger" x="96" y="20" width="72" height="64" rx="5"/>
                <ellipse class="pc-eye" cx="132" cy="42" rx="12" ry="7"/>
                <circle class="pc-dot" cx="132" cy="42" r="3"/>
                <text class="pc-strong" x="132" y="63" text-anchor="middle">cloud</text>
                <text class="pc-text" x="132" y="76" text-anchor="middle">terms</text>
                <line class="pc-line" x1="168" y1="52" x2="198" y2="52" marker-end="url(#pc-screen-arr)"/>
                <rect class="pc-chip" x="202" y="40" width="28" height="24" rx="5"/>
                <text class="pc-text" x="216" y="55" text-anchor="middle">out</text>
                <text class="pc-note" x="132" y="14" text-anchor="middle">processed</text>
                <text class="pc-note" x="132" y="98" text-anchor="middle">logging / retention</text>
              </svg>
            </figure>
            <span class="problem-label">Provider governed</span>
            <p>
              Data routed through a cloud service may be subject to provider
              logging, retention, moderation, and policy. Those terms may be
              reasonable for some tasks, but they are not controlled by the
              user.
            </p>
          </article>
          <article>
            <figure class="problem-card-visual" role="img" aria-label="Separate harnesses keep separate memory stores, creating drift that the operator must reconcile by hand.">
              <svg viewBox="0 0 240 104" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <defs>
                  <marker id="pc-lock-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto">
                    <path class="pc-arrow" d="M0,0 L10,5 L0,10 z"/>
                  </marker>
                </defs>
                <rect class="pc-box" x="10" y="14" width="56" height="26" rx="5"/>
                <text class="pc-text" x="38" y="30" text-anchor="middle">memory A</text>
                <rect class="pc-box" x="92" y="39" width="56" height="26" rx="5"/>
                <text class="pc-text" x="120" y="55" text-anchor="middle">memory B</text>
                <rect class="pc-box" x="174" y="64" width="56" height="26" rx="5"/>
                <text class="pc-text" x="202" y="80" text-anchor="middle">memory C</text>
                <path class="pc-line pc-dashed" d="M66 27 C83 21 91 31 92 47" marker-end="url(#pc-lock-arr)"/>
                <path class="pc-line pc-dashed" d="M148 52 C163 48 172 57 174 72" marker-end="url(#pc-lock-arr)"/>
                <path class="pc-warn" d="M77 66 L90 79 M90 66 L77 79"/>
                <text class="pc-note" x="83" y="93" text-anchor="middle">manual repair</text>
              </svg>
            </figure>
            <span class="problem-label">Locked · fragmented</span>
            <p>
              Each vendor keeps agent memory in its own format, and nothing syncs
              between them. Memory drifts across ChatGPT, Claude, and the next
              tool; you reconcile the gaps by hand, and human memory fails too. An
              assistant meant to lift that burden quietly adds to it.
            </p>
          </article>
        </div>
        <p class="problem-response" id="problem-response">
          Yaaa starts from the opposite end: an assistant for you, on
          infrastructure you own, where memory is one reviewable record, sensitive
          work stays local, and cloud and model use is bounded by mode routing and
          leak checks. Those checks stop sensitive context before it reaches a
          disallowed model or channel. Ownership is not a feature toggle. It
          lives in the architecture.
        </p>
        <figure class="problem-figure" role="img" aria-label="The same data streams gather into one store you own: your source of truth, on your own infrastructure. Sensitive work stays local; cloud and model routes pass mode and leak checks, and side effects pass the fail-closed action gate.">
