---
import Base from '../../../layouts/Base.astro';
import SectionDotNav from '../../../components/SectionDotNav.astro';
import { site } from '../../../data/site';
import {
  conceptNav,
  conceptKits,
  conceptGuarantees,
  conceptDesignDecisions,
  conceptTradeoffs,
  conceptLimitations,
} from '../../../data/amanuensis';
import heroFlowSvg from '../../../figures/amanuensis/fig-hero-flow.svg?raw';
import problemFunnelSvg from '../../../figures/amanuensis/fig-problem-funnel.svg?raw';
import whyLayerSvg from '../../../figures/amanuensis/fig-why-layer.svg?raw';
import exampleIngestSvg from '../../../figures/amanuensis/fig-example-ingest.svg?raw';
import ProjectDiagram from '../../../components/diagram/ProjectDiagram.astro';
import exampleCanvas from '../../../diagrams/amanuensis-example.canvas?raw';
import architectureCanvas from '../../../diagrams/amanuensis-architecture.canvas?raw';

const dotNavItems = [
  { id: 'intro', label: 'Intro', accent: 'ink' as const },
  ...conceptNav.map((item) => ({ id: item.id, label: item.label, accent: 'systems' as const })),
];

const description =
  'Amanuensis protects scarce attention by turning cross-source signals into context-ranked resources, with privacy gates on inference and delivery.';
---

<Base title={`${site.name} · Amanuensis`} description={description} ogType="article" wide showHeader={false}>
  <header class="page-nav" aria-label="Amanuensis navigation">
    <div class="nav-identity">
      <a
        class="nav-home"
        href="/work/#amanuensis"
        aria-label="Back to work index"
        data-umami-event="amanuensis_nav_click"
        data-umami-event-section="work_index"
        data-umami-event-placement="header"
      >
        <span aria-hidden="true">&#8592;</span>
        <span>Portfolio</span>
      </a>
      <a
        class="nav-brand"
        href="#intro"
        aria-current="page"
        data-umami-event="amanuensis_nav_click"
        data-umami-event-section="hero"
        data-umami-event-placement="header"
      >
        Amanuensis
      </a>
    </div>
    <nav class="page-nav__links" aria-label="Amanuensis page sections">
      {conceptNav.map((item) => (
        <a
          href={`#${item.id}`}
          data-umami-event="amanuensis_nav_click"
          data-umami-event-section={item.id}
          data-umami-event-placement="header"
        >
          {item.label}
        </a>
      ))}
      <a
        class="nav-cta"
        href="/projects/amanuensis/walkthrough/"
        data-umami-event="amanuensis_cta_click"
        data-umami-event-cta="walkthrough"
        data-umami-event-placement="header"
      >
        Walkthrough &#8594;
      </a>
    </nav>
    <details class="mobile-nav">
      <summary aria-label="Amanuensis sections">
        <span class="mobile-nav__icon" aria-hidden="true"></span>
        <span class="sr-only">Sections</span>
      </summary>
      <nav aria-label="Amanuensis mobile sections">
        {conceptNav.map((item) => (
          <a
            href={`#${item.id}`}
            data-umami-event="amanuensis_nav_click"
            data-umami-event-section={item.id}
            data-umami-event-placement="mobile_menu"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/projects/amanuensis/walkthrough/"
          data-umami-event="amanuensis_cta_click"
          data-umami-event-cta="walkthrough"
          data-umami-event-placement="mobile_menu"
        >
          Walkthrough &#8594;
        </a>
      </nav>
    </details>
  </header>

  <SectionDotNav items={dotNavItems} />

  <main class="aman-page">
    <section class="hero" id="intro" aria-labelledby="project-title">
      <div class="hero-copy">
        <h1 id="project-title">Amanuensis</h1>
        <p class="hero-position">A read-and-prioritize layer for personal assistants</p>
        <p class="hero-summary">
          Amanuensis sits between personal information sources and delivery channels, using context
          and priority to decide what deserves the foreground. Urgent items go out immediately; necessary
          but not urgent items are held back until a better time. This protects attention without
          discarding signals that may matter later.
        </p>
        <p class="boundary">
          Amanuensis focuses on one job: deciding what deserves attention, and when. Conversation,
          long-term memory, and privileged actions stay with the assistants it serves.
        </p>
        <a
          class="text-link"
          href="/projects/amanuensis/walkthrough/"
          data-umami-event="amanuensis_cta_click"
          data-umami-event-cta="walkthrough"
          data-umami-event-placement="hero"
        >
          Follow one item <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
      <figure
        class="figure figure--hero"
        aria-label="Personal information is gathered, prioritized, and delivered; urgent items go out immediately while the rest fold into a digest window, are held quiet, or are suppressed"
      >
        <Fragment set:html={heroFlowSvg} />
      </figure>
    </section>

    <section id="problem" class="band" aria-labelledby="problem-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">01</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="problem-title">The problem</h2>
        </div>
        <div class="two-col">
          <div>
            <p class="claim">Attention is scarce; information is overwhelming</p>
            <p class="lede">
              Urgent or not, messages from every source draw attention just to be processed. How
              often is a push notification just spam? Without triage, the message is noisy: more
              material to scan, distrust, and discard. Triage changes the equation by ranking each
              signal against context, timing, and an actual plan.
            </p>
            <p class="pull">
              Signal buried in noise remains noise.<br />
              Signal after triage is a resource.<br />
              Resources, organized and reusable, become assets.
            </p>
          </div>
          <figure
            class="figure"
            aria-label="Many signals mixed with noise are compared against context and a real plan; a few become useful foreground resources while the rest stay ambient or are suppressed"
          >
            <Fragment set:html={problemFunnelSvg} />
          </figure>
        </div>
      </div>
    </section>

    <section id="why" class="band band--quiet" aria-labelledby="why-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">02</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="why-title">Why this layer</h2>
        </div>
        <p class="claim">The missing layer is judgment before delivery</p>
        <p class="body body--wide">
          Today's tools move and shorten. Mail, calendar, task, and notification pipelines carry
          messages reliably; assistants summarize them one item at a time. What neither does is
          weigh unlike sources against the same private context - the reader's plans, timing, and
          intent - and make the delivery call before anything is allowed to interrupt.
        </p>
        <p class="body body--wide">
          A private secretary sorting the morning mail made the same judgment: discard the junk,
          file the routine, interrupt only for what cannot wait. Amanuensis rebuilds that role as
          a narrow layer between sources and channels, deciding in context whether an item
          interrupts immediately, folds into the next digest, or stays quiet.
        </p>
        <figure
          class="figure figure--wide"
          aria-label="Mail, task, feed, and calendar signals already get moved and shortened; the missing layer compares them across sources against shared context and decides between immediate delivery, the digest window, and a quiet hold"
        >
          <Fragment set:html={whyLayerSvg} />
        </figure>
        <p class="body section-close">
          The layer stays deliberately narrow: gather, judge, deliver - then leave the sending to
          transport that already works. It organizes and presents; thinking, remembering, and
          acting on the reader's behalf stay with the reader, or with agents built for those jobs.
          The private path - sensitive items never leaving local inference - is an architectural
          guarantee rather than a promise: two gates and one trace, below.
        </p>
      </div>
    </section>

    <section id="example" class="band" aria-labelledby="example-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">03</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="example-title">In practice</h2>
        </div>
        <p class="claim">What's important depends on the context</p>
        <p class="body body--wide">
          A discount flyer is ambient when there is no purchase plan. Repeated as an immediate
          notification, it becomes spam and a spending trap. When a plan already exists - for
          example, replace a desk chair this month - the same offer becomes useful. Amanuensis
          keeps it ambient by default, then surfaces it when the offer matches a real plan. Plans
          arrive the same way anything else does: a memo is ingested as a record, then read as
          context when other items are judged.
        </p>
        <a
          class="text-link"
          href="/projects/amanuensis/walkthrough/"
          data-umami-event="amanuensis_cta_click"
          data-umami-event-cta="walkthrough"
          data-umami-event-placement="example"
        >
          See every stage and failure path <span aria-hidden="true">&#8594;</span>
        </a>
        <figure
          class="figure figure--wide"
          aria-label="A promotions flyer for 20% off ergonomic chairs passes through ingest-kit and becomes one normalized record with a source, a stable ID, and a content hash"
        >
          <Fragment set:html={exampleIngestSvg} />
        </figure>
        <div class="figure figure--wide">
          <ProjectDiagram
            canvasRaw={exampleCanvas}
            accent="systems"
            interactive={false}
            title="The memo carrying a desk chair plan and the flyer are both ingested. With the memo as context, the flyer matches a recent purchase plan, lands on the should tier, and reaches a Discord channel in the next digest window. With no matching plan, it is a regular marketing message: it lands on ambient and is held quiet, nothing sent"
          />
        </div>
      </div>
    </section>

    <section id="how" class="band band--quiet" aria-labelledby="how-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">04</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="how-title">How it works</h2>
        </div>
        <p class="claim">Complexity is broken into stages that can be tested, governed, and traced</p>
        <p class="body body--wide">
          Amanuensis separates source handling, judgment, and delivery into three narrow kits.
          Records move in one direction; private context and policy enter at explicit boundaries,
          while a stable item ID connects every decision. This keeps adapters replaceable, model
          routing auditable, and delivery gates deterministic.
        </p>
        <div class="figure figure--wide">
          <ProjectDiagram
            canvasRaw={architectureCanvas}
            accent="systems"
            title="Ingest-kit, triage-kit, and push-kit in sequence, each writing to its own store; policy gates sit before inference and delivery, and a stable item ID joins the stores into one trace. Drill into a stage for its internal steps"
          />
        </div>
        <div class="kit-sections">
          {conceptKits.map((kit, index) => (
            <article class="kit-section">
              <header class="kit-section__header">
                <p class="kicker">Stage 0{index + 1} · {kit.label}</p>
                <h3>{kit.name}</h3>
                <p class="kit-purpose">{kit.title}</p>
              </header>
              <div class="kit-section__detail">
                <p>{kit.text}</p>
                <p class="kit-flow" aria-label={kit.steps.join(', then ')}>
                  {kit.steps.map((step, stepIndex) => (
                    <Fragment>
                      {stepIndex > 0 && <span aria-hidden="true">&#8594;</span>}
                      {stepIndex === kit.steps.length - 1 ? <strong>{step}</strong> : <span>{step}</span>}
                    </Fragment>
                  ))}
                </p>
                <dl class="kit-details">
                  {kit.details.map((detail) => (
                    <div>
                      <dt>{detail.term}</dt>
                      <dd>{detail.text}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <aside class="kit-rationale">
                <p class="kicker">Why</p>
                <p>{kit.rationale}</p>
              </aside>
            </article>
          ))}
        </div>
        <p class="body section-close">
          Digests leave on their own window schedule rather than on arrival, and an ambient item
          remains available for reconsideration when later context makes it relevant.
        </p>
      </div>
    </section>

    <section id="guarantees" class="band" aria-labelledby="guarantees-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">05</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="guarantees-title">Privacy and traceability</h2>
        </div>
        <p class="claim">Two gates control the route. One trace explains the outcome</p>
        <div class="card-grid guarantee-grid">
          {conceptGuarantees.map((guarantee, index) => (
            <article class="card guarantee-card">
              <p class="guarantee-number" aria-hidden="true">0{index + 1}</p>
              <h3>{guarantee.title}</h3>
              <p class="card-text">{guarantee.text}</p>
            </article>
          ))}
        </div>
        <aside class="loadbearing">
          <p class="stamp" aria-hidden="true">Fail<br />closed</p>
          <div>
            <p class="kicker kicker--refuse">When policy cannot prove the route</p>
            <p class="pull pull--tight">Wait or refuse. Never guess.</p>
            <p class="failclosed-text">
              No model or destination is selected as a convenient fallback.
            </p>
            <p class="failclosed-text">
              Every send can be rehearsed: a dry-run runs the full routing and both gates, prints
              what would be sent, and writes nothing.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section id="decisions" class="band band--quiet" aria-labelledby="decisions-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">06</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="decisions-title">Decisions, trade-offs, and limits</h2>
        </div>
        <div class="decision-grid">
          <article class="decision-group">
            <p class="kicker">Built this way on purpose</p>
            <h3>Design decisions</h3>
            <ul>
              {conceptDesignDecisions.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="decision-group">
            <p class="kicker">What the choices cost</p>
            <h3>Trade-offs</h3>
            <ul>
              {conceptTradeoffs.map((item) => <li>{item}</li>)}
            </ul>
          </article>
          <article class="decision-group">
            <p class="kicker">What remains outside</p>
            <h3>Limitations</h3>
            <ul>
              {conceptLimitations.map((item) => <li>{item}</li>)}
            </ul>
          </article>
        </div>
      </div>
    </section>

    <section class="band band--close" aria-labelledby="close-title">
      <div class="wrap close">
        <p class="kicker" id="close-title">Work in progress</p>
        <p class="claim claim--close">
          Documented in full, ahead of a public release
        </p>
        <p class="body body--tight">
          Amanuensis is developed in a private repository while its interfaces settle. The sensitive
          policy already lives outside the engine, so opening a kit is a visibility flip rather than
          a scrubbing exercise; the code will follow when it is ready to be public.
        </p>
      </div>
    </section>
  </main>
</Base>

<style>
  .page-nav,
  .aman-page {
    --page-max: 72rem;
    --pad: clamp(1.5rem, 4vw, 4rem);
    --sec-pad: clamp(3.5rem, 6vw, 5.5rem);
    --refuse-wash: #f7eee9;
    color: var(--color-ink);
  }

  .page-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
    padding: 0 var(--pad);
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .nav-home,
  .nav-brand {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-home {
    display: none;
    gap: 0.4rem;
    color: var(--color-ink-faint);
  }
  .nav-brand { color: var(--color-ink-soft); }
  .page-nav__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .page-nav__links a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }
  .page-nav__links a:hover,
  .page-nav__links a:focus-visible { color: var(--color-ink); }
  .page-nav__links .nav-cta {
    color: var(--color-accent);
    font-weight: 600;
  }
  .mobile-nav { display: none; margin-left: auto; }
  .mobile-nav > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav > summary::-webkit-details-marker { display: none; }
  .mobile-nav__icon,
  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--color-ink-soft);
    content: '';
  }
  .mobile-nav__icon { position: relative; }
  .mobile-nav__icon::before { position: absolute; top: -6px; }
  .mobile-nav__icon::after { position: absolute; top: 6px; }
  .mobile-nav[open] > nav {
    position: absolute;
    right: var(--pad);
    top: 60px;
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 1.3rem;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
  }
  .mobile-nav nav a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .band { border-top: 1px solid var(--color-line); }
  .band--quiet,
  .band--close { background: var(--color-paper-3); }
  .wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sec-pad) var(--pad);
  }
  .sec-mark {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sec-mark .num { color: var(--color-accent); }
  .sec-mark .slash { color: var(--color-ink-faint); }
  .sec-mark h2 {
    margin: 0;
    font: inherit;
    color: var(--color-ink-soft);
  }
  .kicker {
    margin: 0 0 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .kicker--refuse { color: var(--color-stamp); }
  .lede,
  .body {
    margin: 0 0 1.4rem;
    max-width: 64ch;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }
  .lede { max-width: 56ch; font-size: 1.12rem; }
  .body--wide { max-width: 76ch; }
  .body--tight { margin-bottom: 0.9rem; }
  .claim {
    margin: 0 0 0.9rem;
    max-width: 35ch;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    line-height: 1.4;
    color: var(--color-ink);
  }
  .pull {
    margin: 2rem 0 0;
    max-width: 38ch;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .pull--tight { margin-top: 0; }
  .section-close { margin: 1.8rem 0 0; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 5.8rem) var(--pad) clamp(3rem, 5vw, 4.5rem);
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .hero h1 {
    margin: 1.2rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    font-weight: 600;
    line-height: 1.02;
    color: var(--color-ink);
  }
  .hero-position {
    margin: 1rem 0 0;
    max-width: 32ch;
    font-family: var(--font-serif);
    font-size: 1.3rem;
    line-height: 1.45;
    color: var(--color-ink);
  }
  .hero-summary {
    margin: 1.35rem 0 0;
    max-width: 55ch;
    font-size: 1.08rem;
    line-height: 1.72;
    color: var(--color-ink-soft);
  }
  .boundary {
    margin: 1.15rem 0 0;
    max-width: 55ch;
    padding-left: 1rem;
    font-size: 0.96rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
    border-left: 3px solid var(--color-accent);
  }
  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent);
    text-decoration: none;
  }
  .text-link:hover,
  .text-link:focus-visible { color: var(--color-ink); }

  .figure {
    margin: 0;
    padding: clamp(1.2rem, 2.4vw, 1.6rem);
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
  }
  .figure--wide { margin: 1.8rem 0 1.2rem; padding: clamp(1.4rem, 3vw, 2.2rem); }
  .figure :global(svg) { display: block; width: 100%; height: auto; }

  .two-col {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.1rem;
  }
  .card {
    position: relative;
    min-width: 0;
    padding: 1.35rem;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
  }
  .card h3 {
    margin: 0 0 0.65rem;
    overflow-wrap: anywhere;
    font-size: 1rem;
    line-height: 1.35;
    color: var(--color-ink);
  }
  .card-text {
    margin: 0;
    font-size: 0.94rem;
    line-height: 1.65;
    color: var(--color-ink-soft);
  }

  .kit-sections {
    margin-top: 2.2rem;
    border-top: 1px solid var(--color-line);
  }
  .kit-section {
    display: grid;
    grid-template-columns: minmax(0, 2.6fr) minmax(0, 3.7fr) minmax(0, 3fr);
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: start;
    padding: 2rem 0;
