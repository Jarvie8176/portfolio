---
import Base from '../../../layouts/Base.astro';
import SectionDotNav from '../../../components/SectionDotNav.astro';
import {
  faArrowDown,
  faArrowRotateLeft,
  faArrowUp,
  faCheck,
  faCodeBranch,
  faDatabase,
  faInbox,
  faUserCheck,
  faVolumeXmark,
} from '@fortawesome/free-solid-svg-icons';
  import { site } from '../../../data/site';
  import {
    technicalNav,
    conceptKits,
  conceptGuarantees,
  conceptDesignDecisions,
  conceptFeedbackLoop,
  conceptTradeoffs,
  conceptLimitations,
} from '../../../data/amanuensis';
  import { renderSvg } from '../../../components/diagram/render.mjs';
  import ProjectDiagram from '../../../components/diagram/ProjectDiagram.astro';
  import architectureCanvas from '../../../diagrams/amanuensis-architecture.canvas?raw';

// per-stage flow figures are derived from the architecture canvas SoT so they
// cannot drift from the interactive diagram in this section
const archDoc = JSON.parse(architectureCanvas);
const stageFlowSvg = (ids: string[], title: string): string => {
  const nodes = archDoc.nodes
    .filter((node: { id: string }) => ids.includes(node.id))
    .map((node: { text?: string }) => ({
      ...node,
      text: typeof node.text === 'string' ? node.text.replace('lod: 1', 'lod: 0') : node.text,
    }));
  const edges = archDoc.edges.filter(
    (edge: { fromNode: string; toNode: string }) =>
      ids.includes(edge.fromNode) && ids.includes(edge.toNode),
  );
  return renderSvg(JSON.stringify({ nodes, edges }), { title }).svg;
};
const kitFlowSvgs: Record<string, string> = {
  'ingest-kit': stageFlowSvg(
    ['d-normalize', 'd-dedupe', 'd-identify', 'record-store'],
    'ingest-kit flow: normalize, dedupe, identify, then the record store',
  ),
  'triage-kit': stageFlowSvg(
    ['d-route', 'd-call', 'd-verdict', 'verdict-store'],
    'triage-kit flow: route by sensitivity, one model call, structured verdict, then the verdict store',
  ),
  'push-kit': stageFlowSvg(
    ['d-ladder', 'd-gates', 'd-fold', 'delivery-ledger'],
    'push-kit flow: priority ladder, delivery gates, delivery timing, then the delivery ledger',
  ),
};

interface UiIcon {
  paths: string[];
  viewBox: string;
}

const faIcon = (definition: {
  icon: readonly [number, number, readonly string[], string, string | string[]];
}): UiIcon => {
  const [width, height, , , pathData] = definition.icon;
  return {
    paths: Array.isArray(pathData) ? pathData : [pathData],
    viewBox: `0 0 ${width} ${height}`,
  };
};

const feedbackActions = [
  { label: 'Agree', icon: faIcon(faCheck) },
  { label: 'Higher', icon: faIcon(faArrowUp) },
  { label: 'Lower', icon: faIcon(faArrowDown) },
  { label: 'Mute kind', icon: faIcon(faVolumeXmark) },
];
const feedbackStepIcons = [faInbox, faDatabase, faUserCheck, faCodeBranch].map(faIcon);
const returnIcon = faIcon(faArrowRotateLeft);

const dotNavItems = [
  { id: 'technical-intro', label: 'Technical deep dive', accent: 'ink' as const },
  ...technicalNav.map((item) => ({ id: item.id, label: item.label, accent: 'systems' as const })),
];

const description =
  'A technical deep dive into the Amanuensis architecture, privacy gates, correction loop, design decisions, trade-offs, and limits.';
---

<Base title={`${site.name} · Amanuensis technical deep dive`} description={description} ogType="article" wide showHeader={false}>
  <header class="page-nav" aria-label="Amanuensis technical navigation">
    <div class="nav-identity">
      <a
        class="nav-home"
          href="/projects/amanuensis/"
          aria-label="Back to the Amanuensis concept page"
        data-umami-event="amanuensis_nav_click"
          data-umami-event-section="concept"
        data-umami-event-placement="header"
      >
        <span aria-hidden="true">&#8592;</span>
          <span>Concept</span>
      </a>
      <a
        class="nav-brand"
          href="#technical-intro"
        aria-current="page"
        data-umami-event="amanuensis_nav_click"
          data-umami-event-section="technical_intro"
        data-umami-event-placement="header"
      >
          Technical deep dive
      </a>
    </div>
      <nav class="page-nav__links" aria-label="Technical deep dive sections">
        {technicalNav.map((item) => (
        <a
          href={`#${item.id}`}
          data-umami-event="amanuensis_nav_click"
          data-umami-event-section={item.id}
          data-umami-event-placement="header"
        >
          {item.label}
        </a>
      ))}
      <a
        class="nav-cta"
        href="/projects/amanuensis/walkthrough/"
        data-umami-event="amanuensis_cta_click"
        data-umami-event-cta="walkthrough"
        data-umami-event-placement="header"
      >
        Walkthrough &#8594;
      </a>
    </nav>
      <details class="mobile-nav">
        <summary aria-label="Technical deep dive sections">
        <span class="mobile-nav__icon" aria-hidden="true"></span>
        <span class="sr-only">Sections</span>
      </summary>
        <nav aria-label="Technical deep dive mobile sections">
          {technicalNav.map((item) => (
          <a
            href={`#${item.id}`}
            data-umami-event="amanuensis_nav_click"
            data-umami-event-section={item.id}
            data-umami-event-placement="mobile_menu"
          >
            {item.label}
          </a>
        ))}
        <a
          href="/projects/amanuensis/walkthrough/"
          data-umami-event="amanuensis_cta_click"
          data-umami-event-cta="walkthrough"
          data-umami-event-placement="mobile_menu"
        >
          Walkthrough &#8594;
        </a>
      </nav>
    </details>
  </header>

  <SectionDotNav items={dotNavItems} />

  <main class="aman-page">
    <section class="hero hero--technical" id="technical-intro" aria-labelledby="technical-title">
      <div class="hero-copy">
        <p class="kicker">Amanuensis / Technical deep dive</p>
        <h1 id="technical-title">Boundaries before intelligence</h1>
        <p class="hero-summary">
          The system is split into narrow stages so collection, inference, and delivery can be
          inspected independently. Deterministic policy gates decide where sensitive data may go;
          a stable item ID explains what happened from receipt to final outcome.
        </p>
        <p class="boundary">
          Start here for architecture and rationale. Use the example walkthrough to inspect one
          representative item, including records and failure paths.
        </p>
        <a
          class="text-link"
          href="/projects/amanuensis/walkthrough/"
          data-umami-event="amanuensis_cta_click"
          data-umami-event-cta="walkthrough"
          data-umami-event-placement="technical_hero"
        >
          Open the example walkthrough <span aria-hidden="true">&#8594;</span>
        </a>
      </div>
      <div class="technical-index" aria-label="Technical deep dive contents">
        <p class="kicker">Inside this view</p>
        <ol>
          <li><span>01</span> Architecture and kits</li>
          <li><span>02</span> Privacy and traceability</li>
          <li><span>03</span> Correction loop</li>
          <li><span>04</span> Decisions and limits</li>
        </ol>
      </div>
    </section>

    <section id="architecture" class="band band--quiet" aria-labelledby="architecture-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">01</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="architecture-title">Architecture and kits</h2>
        </div>
        <p class="claim">Separation of concerns, local reasoning, transparency</p>
        <p class="body body--wide">
          Amanuensis separates source handling, judgment, and delivery into three narrow kits.
          Records move in one direction; private context and policy enter at explicit boundaries,
          while a stable item ID connects every decision. This keeps adapters replaceable, model
          routing auditable, and delivery gates deterministic.
        </p>
        <div class="figure figure--wide">
          <ProjectDiagram
            canvasRaw={architectureCanvas}
            accent="systems"
            title="Ingest-kit, triage-kit, and push-kit in sequence, each writing to its own store; policy gates sit before inference and delivery, and a stable item ID joins the stores into one trace. Drill into a stage for its internal steps"
          />
        </div>
        <div class="kit-sections">
          {conceptKits.map((kit, index) => (
            <article class="kit-section">
              <div class="kit-section__main">
                <header class="kit-section__header">
                  <p class="kicker">Stage 0{index + 1} · {kit.label}</p>
                  <h3>{kit.name}</h3>
                  <p class="kit-purpose">{kit.title}</p>
                </header>
                <p class="kit-text">{kit.text}</p>
                <dl class="kit-details">
                  {kit.details.map((detail) => (
                    <div>
                      <dt>{detail.term}</dt>
                      <dd>{detail.text}</dd>
                    </div>
                  ))}
                </dl>
              </div>
              <div class="kit-section__side">
                <figure class="kit-flow-fig" aria-label={kit.steps.join(', then ')}>
                  <Fragment set:html={kitFlowSvgs[kit.name]} />
                </figure>
                <aside class="kit-rationale">
                  <p class="kicker">Why</p>
                  <p>{kit.rationale}</p>
                </aside>
              </div>
            </article>
          ))}
        </div>
        <p class="body section-close">
          Digests leave on their own window schedule rather than on arrival, and an ambient item
          remains available for reconsideration when later context makes it relevant.
        </p>
      </div>
    </section>

    <section id="guarantees" class="band" aria-labelledby="guarantees-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">02</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="guarantees-title">Privacy and traceability</h2>
        </div>
        <p class="claim">Two gates control the route. One trace explains the outcome</p>
        <div class="card-grid guarantee-grid">
          {conceptGuarantees.map((guarantee, index) => (
            <article class="card guarantee-card">
              <p class="guarantee-number" aria-hidden="true">0{index + 1}</p>
              <h3>{guarantee.title}</h3>
              <p class="card-text">{guarantee.text}</p>
            </article>
          ))}
        </div>
        <aside class="loadbearing">
          <p class="stamp" aria-hidden="true">Fail<br />closed</p>
          <div>
            <p class="kicker kicker--refuse">When policy cannot prove the route</p>
            <p class="pull pull--tight">The item waits, or the send is refused.</p>
            <p class="failclosed-text">
              It never substitutes a cloud model for an unreachable local one, or a different
              channel for a blocked send, just to get the message out.
            </p>
            <p class="failclosed-text">
              Every send can be rehearsed: a dry-run runs the full routing and both gates, prints
              what would be sent, and writes nothing.
            </p>
          </div>
        </aside>
      </div>
    </section>

    <section id="feedback" class="band band--quiet" aria-labelledby="feedback-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">03</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="feedback-title">The feedback loop</h2>
        </div>
        <p class="claim">Human-in-the-loop (HITL) review turns corrections into rules</p>
        <p class="body body--wide">
          Triage that cannot be corrected slowly drifts away from its reader. Delivery is not the
          end of the pipeline: every eligible verdict can be scored in a private review channel,
          including items that were suppressed. A quality correction returns as data - captured,
          condensed, reviewed by a person, and applied - rather than as a prompt tweak the model is
          trusted to honor. Human judgment remains authoritative over the model.
        </p>
        <figure class="feedback-loop-figure" aria-labelledby="feedback-figure-title">
          <figcaption id="feedback-figure-title" class="feedback-figure-caption">
            One quality correction, carried into the next matching verdict
          </figcaption>
          <div class="feedback-loop-layout">
            <div class="review-surface">
              <p class="review-surface__label">Private review channel</p>
              <article class="review-card" aria-label="Example review card">
                <div class="review-card__meta">
                  <span>newsletter feed</span>
                  <span class="review-priority">should</span>
                </div>
                <h3>Account agreement update</h3>
                <p class="review-summary">
                  The sender changed its standard terms. No action is required this week.
                </p>
                <ul class="review-actions" aria-label="One-tap quality verdicts">
                  {feedbackActions.map((action) => (
                    <li class="review-action">
                      <svg viewBox={action.icon.viewBox} aria-hidden="true" focusable="false">
                        {action.icon.paths.map((path) => <path d={path} />)}
                      </svg>
                      <span>{action.label}</span>
                    </li>
                  ))}
                </ul>
                <div class="written-correction">
                  <p>Written correction</p>
                  <q>Notifications from this sender should default to fyi.</q>
                </div>
              </article>
            </div>

            <div class="feedback-connector" aria-hidden="true">
              <span>quality correction</span>
              <b>&#8594;</b>
            </div>

            <div class="feedback-process">
              <ol class="feedback-steps">
                {conceptFeedbackLoop.map((step, index) => (
                  <li class="feedback-step">
                    <span class="feedback-step__icon" aria-hidden="true">
                      <svg viewBox={feedbackStepIcons[index].viewBox} focusable="false">
                        {feedbackStepIcons[index].paths.map((path) => <path d={path} />)}
                      </svg>
                    </span>
                    <div>
                      <p class="feedback-step__label">0{index + 1} / {step.label}</p>
                      <h3>{step.title}</h3>
                      <p>{step.text}</p>
                    </div>
                  </li>
                ))}
              </ol>

              <div class="feedback-outcome">
                <p class="kicker">Next matching item</p>
                <div class="feedback-transition" aria-label="The model says should; the reviewed rule changes the final verdict to fyi">
                  <span><small>model verdict</small>should</span>
                  <b aria-hidden="true">&#8594;</b>
                  <span class="feedback-transition__final"><small>reviewed rule</small>fyi</span>
                </div>
                <p>Same sender, deterministic override, no model retraining.</p>
              </div>
            </div>
          </div>
          <div class="feedback-return">
            <svg viewBox={returnIcon.viewBox} aria-hidden="true" focusable="false">
              {returnIcon.paths.map((path) => <path d={path} />)}
            </svg>
            <span>The next item returns to the same review surface, closing the loop.</span>
          </div>
        </figure>

        <div class="feedback-notes">
          <aside class="feedback-note feedback-note--guard">
            <p class="kicker">Capture boundary</p>
            <p class="pull pull--tight">Record and hand off. Never act.</p>
            <p class="failclosed-text">
              Loop guards keep the system's own output out of its input. A quality score cannot
              echo back as another delivery, and an action request belongs to a separate path.
            </p>
          </aside>
          <aside class="feedback-note feedback-note--safe">
            <p class="kicker">With zero feedback</p>
            <p class="pull pull--tight">Conservative defaults keep working.</p>
            <p class="failclosed-text">
              Feedback accelerates calibration; it is not a runtime dependency. Reviewed rules
              come before rubric changes, curated examples, or fine-tuning.
            </p>
          </aside>
        </div>
      </div>
    </section>

    <section id="decisions" class="band" aria-labelledby="decisions-title">
      <div class="wrap">
        <div class="sec-mark">
          <span class="num">04</span><span class="slash" aria-hidden="true">/</span>
          <h2 id="decisions-title">Decisions, trade-offs, and limits</h2>
        </div>
        <div class="decision-block">
          <p class="kicker">Determinism and control</p>
          <h3>Design decisions</h3>
          <div class="decision-cards">
            {conceptDesignDecisions.map((item) => (
              <article class="decision-card">
                <p class="decision-lead">{item.lead}</p>
                <p class="decision-text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
        <div class="decision-block">
          <p class="kicker">What the choices cost</p>
          <h3>Trade-offs</h3>
          <div class="tradeoff-list">
            {conceptTradeoffs.map((item) => (
              <div class="tradeoff-row">
                <p class="tradeoff-pair">
                  <span class="tradeoff-keep">{item.keep}</span>
                  <span class="tradeoff-vs" aria-hidden="true">vs</span>
                  <span class="tradeoff-cost">{item.cost}</span>
                </p>
                <p class="decision-text">{item.text}</p>
              </div>
            ))}
          </div>
        </div>
        <div class="decision-block">
          <p class="kicker">What remains outside</p>
          <h3>Limitations</h3>
          <div class="limit-cards">
            {conceptLimitations.map((item) => (
              <article class="limit-card">
                <p class="decision-lead">{item.lead}</p>
                <p class="decision-text">{item.text}</p>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="band band--close" aria-labelledby="close-title">
      <div class="wrap close close--routes">
        <div>
          <p class="kicker" id="close-title">Continue with evidence</p>
          <p class="claim claim--close">Follow one item through every record and failure path.</p>
        </div>
        <div class="close-actions">
          <a class="text-link" href="/projects/amanuensis/">
            <span aria-hidden="true">&#8592;</span> Back to the concept
          </a>
          <a class="btn" href="/projects/amanuensis/walkthrough/">Open the example walkthrough</a>
        </div>
      </div>
    </section>
  </main>
</Base>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.mobile-nav').forEach((menu) => {
    menu.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
      link.addEventListener('click', () => menu.removeAttribute('open'));
    });
  });
</script>

<style>
  .page-nav,
  .aman-page {
    --page-max: 72rem;
    --pad: clamp(1.5rem, 4vw, 4rem);
    --sec-pad: clamp(3.5rem, 6vw, 5.5rem);
    --refuse-wash: #f7eee9;
    color: var(--color-ink);
  }

  .page-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 64px;
    padding: 0 var(--pad);
    background: color-mix(in srgb, var(--color-paper) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--color-line);
  }
  .nav-identity {
    display: flex;
    align-items: center;
    gap: 1rem;
    min-width: 0;
  }
  .nav-home,
  .nav-brand {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    white-space: nowrap;
    text-decoration: none;
  }
  .nav-home {
    display: none;
    gap: 0.4rem;
    color: var(--color-ink-faint);
  }
  .nav-brand { color: var(--color-ink-soft); }
  .page-nav__links {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .page-nav__links a {
    color: var(--color-ink-faint);
    text-decoration: none;
  }
  .page-nav__links a:hover,
  .page-nav__links a:focus-visible { color: var(--color-ink); }
  .page-nav__links .nav-cta {
    color: var(--color-accent);
    font-weight: 600;
  }
  .mobile-nav { display: none; margin-left: auto; }
  .mobile-nav > summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    list-style: none;
  }
  .mobile-nav > summary::-webkit-details-marker { display: none; }
  .mobile-nav__icon,
  .mobile-nav__icon::before,
  .mobile-nav__icon::after {
    display: block;
    width: 18px;
    height: 1px;
    background: var(--color-ink-soft);
    content: '';
  }
  .mobile-nav__icon { position: relative; }
  .mobile-nav__icon::before { position: absolute; top: -6px; }
  .mobile-nav__icon::after { position: absolute; top: 6px; }
  .mobile-nav[open] > nav {
    position: absolute;
    right: var(--pad);
    top: 60px;
    display: grid;
    gap: 0.9rem;
    padding: 1.1rem 1.3rem;
    background: var(--color-paper-2);
    border: 1px solid var(--color-line);
  }
  .mobile-nav nav a {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    text-decoration: none;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .band { border-top: 1px solid var(--color-line); }
  .band--quiet,
  .band--close { background: var(--color-paper-3); }
  .wrap {
    max-width: var(--page-max);
    margin: 0 auto;
    padding: var(--sec-pad) var(--pad);
  }
  .sec-mark {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    margin: 0 0 2rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }
  .sec-mark .num { color: var(--color-accent); }
  .sec-mark .slash { color: var(--color-ink-faint); }
  .sec-mark h2 {
    margin: 0;
    font: inherit;
    color: var(--color-ink-soft);
  }
  .kicker {
    margin: 0 0 0.8rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-faint);
  }
  .kicker--refuse { color: var(--color-stamp); }
  .lede,
  .body {
    margin: 0 0 1.4rem;
    max-width: 64ch;
    font-size: 1.05rem;
    line-height: 1.75;
    color: var(--color-ink-soft);
  }
  .lede { max-width: 56ch; font-size: 1.12rem; }
  .body--wide { max-width: 76ch; }
  .body--tight { margin-bottom: 0.9rem; }
  .claim {
    margin: 0 0 0.9rem;
    max-width: 35ch;
    font-family: var(--font-serif);
    font-size: clamp(1.3rem, 2.4vw, 1.55rem);
    line-height: 1.4;
    color: var(--color-ink);
  }
  .pull {
    margin: 2rem 0 0;
    max-width: 38ch;
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .pull--tight { margin-top: 0; }
  .section-close { margin: 1.8rem 0 0; }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
    max-width: var(--page-max);
    margin: 0 auto;
    padding: clamp(3.5rem, 7vw, 5.8rem) var(--pad) clamp(3rem, 5vw, 4.5rem);
  }
  .eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--color-accent);
  }
  .hero h1 {
    margin: 1.2rem 0 0;
    font-family: var(--font-serif);
    font-size: clamp(2.8rem, 6vw, 4.4rem);
    font-weight: 600;
