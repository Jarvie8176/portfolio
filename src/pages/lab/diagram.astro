---
// Dev harness for the shared diagram pipeline (not linked in nav).
import ProjectDiagram from '../../components/diagram/ProjectDiagram.astro';
import yaaaCanvas from '../../diagrams/yaaa.canvas?raw';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>diagram pipeline - lab</title>
    <style>
      body { margin: 0; background: #f6f7f5; font-family: system-ui, sans-serif; color: #1b1d1f; }
      main { max-width: 1100px; margin: 0 auto; padding: 3rem 1.5rem; }
      h1 { font-size: 1.4rem; }
      .frame { border: 1px solid #dce1de; border-radius: 12px; background: #fcfbf7; padding: 1rem; }
    </style>
  </head>
  <body>
    <main>
      <h1>Yaaa - architecture diagram (pipeline e2e)</h1>
      <p>Source of truth: <code>src/diagrams/yaaa.canvas</code>. Rendered at build; d3 semantic zoom attaches at runtime.</p>
      <div class="frame">
        <ProjectDiagram canvasRaw={yaaaCanvas} accent="systems" title="Yaaa - authority map" />
      </div>
    </main>
  </body>
</html>
