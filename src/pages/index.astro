---
import Base from '../layouts/Base.astro';
import CoverGallery from '../components/CoverGallery.astro';
import PracticeIndex from '../components/PracticeIndex.astro';
import { practiceLabels, projects, type Practice, type Project } from '../data/projects';
import { site } from '../data/site';

const groupedProjects = (Object.keys(practiceLabels) as Practice[]).map((practice) => ({
  practice,
  label: practiceLabels[practice],
  projects: projects.filter((project) => project.primary === practice),
}));

const statusClass: Record<Project['statusCode'], string> = {
  operational: 'status-operational',
  integration: 'status-integration',
  prototype: 'status-prototype',
  research_build: 'status-research',
  concept: 'status-concept',
  archive: 'status-archive',
};
---

<Base
  title={`${site.name} — ${site.homeTitle}`}
  description={site.description}
  wide
>
  <main id="work" class="home">
    <CoverGallery projects={projects} />

    {groupedProjects.map((group) => (
      <section class={`practice-block practice-${group.practice}`} id={group.practice}>
        <div class="practice-heading">
          <span>{group.label}</span>
          <p>
            {group.practice === 'systems' &&
              'Working systems for memory, attention, filtering, surfaces, and safety.'}
            {group.practice === 'embodied' &&
              'Projects that return AI and media to bodies, care, movement, and daily life.'}
            {group.practice === 'worlds' &&
              'Worlds shared with agents, animals, strangers, places, and public space.'}
          </p>
        </div>

        {group.projects.map((project, index) => (
          <article
            class={`project-section layout-${index % 2 === 0 ? 'visual-left' : 'visual-right'}`}
            id={project.id}
            data-project-section
            data-practice={project.primary}
            data-project-title={project.title}
          >
            <div class="evidence-artifact" aria-label={`${project.title} image material`}>
              <div
                class={`artifact-surface practice-${project.primary}`}
                style={`--artifact-image: url('${project.coverImage}'); --artifact-position: ${project.coverPosition ?? 'center'};`}
              ></div>
            </div>

            <div class="project-copy">
              <div class="badge-row">
                <span class="role-badge">{project.role}</span>
                <span class={`status-badge ${statusClass[project.statusCode]}`}>
                  {project.statusLabel}
                </span>
                <span class={`mode-tag practice-${project.primary}`}>
                  {practiceLabels[project.primary]}
                </span>
                {project.secondary && (
                  <span class={`mode-tag practice-${project.secondary}`}>
                    {practiceLabels[project.secondary]}
                  </span>
                )}
              </div>
              <p class="topic">{project.topic}</p>
              <h2>
                {project.href ? <a href={project.href}>{project.title}</a> : project.title}
              </h2>
              <p class="summary">{project.summary}</p>
            </div>
          </article>
        ))}
      </section>
    ))}

    <section class="practice-map" id="notes" data-project-section data-practice="worlds" data-project-title="Practice Map">
      <div class="practice-heading">
        <span>Practice Map</span>
        <p>The work is grouped by primary practice, but each project crosses at least one border.</p>
      </div>
      <div class="map-grid">
        {groupedProjects.map((group) => (
          <div class={`map-column practice-${group.practice}`}>
            <h2>{group.label}</h2>
            {projects.map((project) => (
              <div class:list={['map-node', { 'is-primary': project.primary === group.practice, 'is-secondary': project.secondary === group.practice }]}>
                <span>{project.title}</span>
                <small>
                  {project.primary === group.practice && 'primary'}
                  {project.secondary === group.practice && 'secondary'}
                </small>
              </div>
            ))}
          </div>
        ))}
      </div>
    </section>

    <section class="closing" id="about">
      <p>
        These projects explore how AI and software can support a person without
        replacing the person. Some build systems for remembering, filtering,
        deciding, and acting with care. Some return to the body: walking,
        disability, memory, and daily life. Others look at worlds we live in
        with agents, animals, strangers, places, and public space.
      </p>
      <div class="closing-links" aria-label="Reader paths">
        <a href="#systems">Systems</a>
        <a href="#embodied">Embodied Life</a>
        <a href="#worlds">Inhabited Worlds</a>
        <a href="/colophon/">Colophon</a>
      </div>
    </section>
  </main>

  <PracticeIndex projects={projects} />
</Base>

<style>
  .home {
    background: var(--paper);
  }

  .practice-block,
  .practice-map,
  .closing {
    padding: clamp(3rem, 7vh, 4.5rem) clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid var(--rule);
  }

  .practice-heading {
    max-width: 68rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    display: grid;
    grid-template-columns: minmax(9rem, 0.28fr) minmax(0, 0.72fr);
    gap: clamp(1.25rem, 3vw, 3rem);
    align-items: end;
  }

  .practice-heading span {
    color: currentColor;
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .practice-heading p {
    margin: 0;
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: clamp(1rem, 1.5vw, 1.2rem);
    line-height: 1.7;
  }

  .practice-systems { color: var(--systems); }
  .practice-embodied { color: var(--embodied); }
  .practice-worlds { color: var(--worlds); }

  .project-section {
    max-width: 68rem;
    min-height: auto;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(17rem, 0.9fr) minmax(17rem, 1fr);
    gap: clamp(2rem, 4vw, 4rem);
    align-items: center;
    padding: clamp(2.75rem, 6vh, 4rem) 0;
  }

  .project-section + .project-section {
    border-top: 1px solid var(--rule);
  }

  .layout-visual-right .evidence-artifact {
    order: 2;
  }

  .evidence-artifact {
    min-width: 0;
  }

  .artifact-surface {
    position: relative;
    min-height: auto;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background:
      linear-gradient(160deg, color-mix(in srgb, currentColor 9%, transparent), transparent 58%),
      repeating-linear-gradient(
        0deg,
        color-mix(in srgb, currentColor 8%, transparent) 0 1px,
        transparent 1px 32px
      ),
      var(--surface);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, currentColor 8%, transparent);
  }

  .artifact-surface::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image: var(--artifact-image);
    background-position: var(--artifact-position);
    background-size: cover;
    opacity: 0.88;
    filter: saturate(0.92);
  }

  .artifact-surface::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(160deg, color-mix(in srgb, currentColor 16%, transparent), transparent 52%),
      linear-gradient(0deg, color-mix(in srgb, var(--paper) 22%, transparent), transparent 44%);
  }

  .role-badge,
  .status-badge,
  .topic,
  .mode-tag {
    font-family: var(--mono);
    font-size: 0.64rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .project-copy {
    min-width: 0;
    max-width: 34rem;
    color: var(--ink);
  }

  .badge-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
  }

  .role-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.45rem;
    padding: 0 0.48rem;
    border-radius: 3px;
    background: color-mix(in srgb, currentColor 11%, transparent);
    color: currentColor;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0 0.52rem;
    border: 1px solid currentColor;
    border-radius: 3px;
    background: transparent;
    color: var(--ink-soft);
  }

  .status-operational { color: var(--embodied); }
  .status-integration,
  .status-prototype,
  .status-research { color: var(--systems); }
  .status-concept,
  .status-archive { color: var(--worlds); }

  .project-copy h2 {
    margin: 0.8rem 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3.35rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .project-copy h2 a {
    color: inherit;
    text-decoration: none;
  }

  .project-copy h2 a:hover {
    color: var(--accent);
  }

  .summary {
    max-width: 32rem;
    margin: 1rem 0 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(1rem, 1.35vw, 1.18rem);
    line-height: 1.65;
  }

  .topic {
    margin: 1.3rem 0 0;
    color: var(--ink-faint);
  }

  .mode-tag {
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    background: color-mix(in srgb, currentColor 9%, transparent);
    color: currentColor;
  }

  .map-grid {
    max-width: 72rem;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .map-column {
    min-width: 0;
    padding: 1.2rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    background: var(--surface);
  }

  .map-column h2 {
    margin: 0 0 1rem;
    color: currentColor;
    font-family: var(--mono);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .map-node {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    border-top: 1px solid var(--rule);
    color: var(--ink-faint);
    font-family: var(--sans);
  }

  .map-node.is-primary {
    color: var(--ink);
    font-weight: 700;
  }

  .map-node.is-secondary {
    color: var(--ink-soft);
  }

  .map-node small {
    color: currentColor;
    font-family: var(--mono);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .closing {
    padding-bottom: 8rem;
  }

  .closing p {
    max-width: 54rem;
    margin: 0 auto;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    line-height: 1.45;
  }

  .closing-links {
    max-width: 54rem;
    margin: 2rem auto 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .closing-links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0 0.8rem;
    border: 1px solid var(--rule);
    border-radius: 3px;
    background: var(--surface);
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.76rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .closing-links a:hover {
    border-color: var(--rule-hard);
    color: var(--ink);
  }

  @media (max-width: 860px) {
    .practice-heading,
    .project-section,
    .map-grid {
      grid-template-columns: 1fr;
    }

    .project-section {
      min-height: auto;
    }

    .layout-visual-right .evidence-artifact {
      order: 0;
    }
  }
</style>
