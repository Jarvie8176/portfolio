---
import Base from '../layouts/Base.astro';
import CoverGallery from '../components/CoverGallery.astro';
import PracticeIndex from '../components/PracticeIndex.astro';
import ProjectSections from '../components/ProjectSections.astro';
import { projects } from '../data/projects';
import { site } from '../data/site';
---

<Base
  title={`${site.name} — ${site.homeTitle}`}
  description={site.description}
  wide
>
  <main id="work" class="home">
    <CoverGallery projects={projects} />
    <ProjectSections />
  </main>

  <PracticeIndex projects={projects} />
</Base>

<style>
  .home {
    background: var(--paper);
  }
</style>
