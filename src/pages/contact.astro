---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---

<Base
  title={`${site.name} — Contact`}
  description="Contact and source links for J. Kong."
  crumb="Contact"
>
  <main class="contact-page" aria-labelledby="contact-title">
    <section class="contact-card">
      <span>Contact</span>
      <h1 id="contact-title">{site.name}</h1>
      <p>{site.role}</p>
      <a class="contact-link" href={site.githubUrl} rel="me noopener" target="_blank">GitHub</a>
    </section>
  </main>
</Base>

<style>
  .contact-page {
    min-height: calc(100svh - var(--site-header-min) - 6rem);
    display: grid;
    align-items: center;
    padding: clamp(4rem, 10vw, 8rem) 0;
  }

  .contact-card {
    max-width: 36rem;
  }

  .contact-card span {
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-card h1 {
    margin: 1rem 0 0;
    color: var(--ink);
    font-family: var(--serif);
    font-size: clamp(2.6rem, 6vw, 4.8rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.02;
  }

  .contact-card p {
    margin: 1.25rem 0 0;
    color: var(--ink);
    font-family: var(--sans);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    line-height: 1.7;
  }

  .contact-link {
    display: inline-flex;
    margin-top: 1.75rem;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .contact-link:hover {
    color: var(--stamp);
  }
</style>
