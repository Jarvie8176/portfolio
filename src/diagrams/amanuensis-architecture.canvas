		{
			"id": "inbound-policy",
			"type": "text",
			"x": 460,
			"y": -32,
			"width": 300,
			"height": 64,
			"text": "<!-- type: gate, layer: L4, lod: 0, block: none -->\ninbound policy gate\nselects the allowed model route"
		},
		{
			"id": "outbound-policy",
			"type": "text",
			"x": 860,
			"y": -32,
			"width": 300,
			"height": 64,
			"text": "<!-- type: gate, layer: L4, lod: 0, block: none -->\noutbound audience gate\naudience and sensitivity, fail closed"
		},
		{
			"id": "ingest-kit",
			"type": "text",
			"x": 60,
			"y": 140,
			"width": 300,
			"height": 90,
			"text": "<!-- type: process, layer: L1, lod: 0, block: none -->\ningest-kit\nmake sources comparable"
		},
		{
			"id": "triage-kit",
			"type": "text",
			"x": 460,
			"y": 140,
			"width": 300,
			"height": 90,
			"text": "<!-- type: process, layer: L1, lod: 0, block: none -->\ntriage-kit\nturn context into a decision"
		},
		{
			"id": "push-kit",
			"type": "text",
			"x": 860,
			"y": 140,
			"width": 300,
			"height": 90,
			"text": "<!-- type: process, layer: L1, lod: 0, block: none -->\npush-kit\nspend attention deliberately"
		},
		{
			"id": "d-normalize",
			"type": "text",
			"x": 60,
			"y": 270,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: INGEST, lod: 1, block: none -->\nnormalize\none record shape for every source"
		},
		{
			"id": "d-dedupe",
			"type": "text",
			"x": 60,
			"y": 345,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: INGEST, lod: 1, block: none -->\ndedupe\ncontent hashing drops repeats"
		},
		{
			"id": "d-identify",
			"type": "text",
			"x": 60,
			"y": 420,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: INGEST, lod: 1, block: none -->\nidentify\nassigns the stable item ID"
		},
		{
			"id": "d-route",
			"type": "text",
			"x": 460,
			"y": 270,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: TRIAGE, lod: 1, block: none -->\nroute by sensitivity\nsensitive items go local-only"
		},
		{
			"id": "d-call",
			"type": "text",
			"x": 460,
			"y": 345,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: TRIAGE, lod: 1, block: none -->\none model call\nconstrained decoding, no invalid priority"
		},
		{
			"id": "d-verdict",
			"type": "text",
			"x": 460,
			"y": 420,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: TRIAGE, lod: 1, block: none -->\nstructured verdict\npriority, audience, sensitivity, relevance"
		},
		{
			"id": "d-ladder",
			"type": "text",
			"x": 860,
			"y": 270,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: PUSH, lod: 1, block: none -->\nladder rung\nmust, should, fyi, ambient, drop"
		},
		{
			"id": "d-gates",
			"type": "text",
			"x": 860,
			"y": 345,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: PUSH, lod: 1, block: none -->\ndelivery gates\nread persisted values, fail closed"
		},
		{
			"id": "d-fold",
			"type": "text",
			"x": 860,
			"y": 420,
			"width": 300,
			"height": 56,
			"text": "<!-- type: process, layer: PUSH, lod: 1, block: none -->\ndigest fold\ndeferred items age upward"
		},
		{
			"id": "record-store",
			"type": "text",
			"x": 60,
			"y": 520,
			"width": 300,
			"height": 56,
			"text": "<!-- type: store, layer: L2, lod: 0, block: entity -->\nrecord store\ncontent-hashed"
		},
		{
			"id": "verdict-store",
			"type": "text",
			"x": 460,
			"y": 520,
			"width": 300,
			"height": 56,
			"text": "<!-- type: store, layer: L2, lod: 0, block: entity -->\nverdict store\nversioned by route"
		},
		{
			"id": "delivery-ledger",
			"type": "text",
			"x": 860,
			"y": 520,
			"width": 300,
			"height": 56,
			"text": "<!-- type: store, layer: L2, lod: 0, block: entity -->\ndelivery ledger\nidempotent"
		},
		{
			"id": "trace",
			"type": "text",
			"x": 340,
			"y": 680,
			"width": 540,
			"height": 56,
			"text": "<!-- type: store, layer: L2, lod: 0, block: entity -->\nstable item ID\none trace connects every decision"
		}
	],
