---
import { site } from "../../data/site";

const films = [
    {
        id: "yb2x__bJyyE",
        title: "Stanley Park",
        location: "Vancouver, BC",
        description: "An autumn walk through forest paths and along the waterfront.",
        accessibleTitle: "Stanley Park 360° Autumn Walk | Vancouver | 8K Spatial Audio | Trailwalk",
    },
    {
        id: "OUYpwkCitwM",
        title: "Richmond Nature Park",
        location: "Richmond, BC",
        description: "Forest paths, autumn leaves and the sounds of a local nature park.",
        accessibleTitle: "Richmond Nature Park 360° Walking Tour | Autumn in 8K · Spatial Audio",
    },
];

---

<section class="productions" id="production" aria-labelledby="production-title">
    <div class="productions__inner">
        <div class="productions__heading">
            <div>
                <p class="productions__kicker">YouTube production</p>
                <h2 id="production-title">Walks you can watch</h2>
                <p class="productions__intro">
                    From a walk in the field to a finished film. Explore full-length
                    360-degree walks with the sounds recorded in each place,
                    published through Trailwalk Studio.
                </p>
            </div>
            <a
                class="productions__channel"
                href={site.trailwalkYoutubeUrl}
                target="_blank"
                rel="noreferrer"
                data-umami-event="trailwalk_production_click"
                data-umami-event-destination="channel"
                aria-label="Visit Trailwalk Studio on YouTube (opens in a new tab)"
            >
                Explore the channel <span aria-hidden="true">↗</span>
            </a>
        </div>

        <div class="productions__films">
            {
                films.map((film) => (
                    <article class="film">
                        <a
                            class="film__link"
                            href={`https://www.youtube.com/watch?v=${film.id}`}
                            target="_blank"
                            rel="noreferrer"
                            aria-label={`Watch ${film.accessibleTitle} on YouTube (opens in a new tab)`}
                            data-umami-event="trailwalk_production_click"
                            data-umami-event-destination={film.id}
                        >
                            <div class="film__image">
                                <img
                                    src={`https://i.ytimg.com/vi/${film.id}/maxresdefault.jpg`}
                                    alt=""
                                    width="1280"
                                    height="720"
                                    loading="lazy"
                                    decoding="async"
                                    referrerpolicy="no-referrer"
                                />
                                <span class="film__play" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M9 5.5v13l10-6.5z" />
                                    </svg>
                                </span>
                            </div>
                            <div class="film__copy">
                                <p class="film__location">{film.location}</p>
                                <h3>{film.title}</h3>
                                <p class="film__description">{film.description}</p>
                                <div class="film__footer">
                                    <span class="film__format">8K · 360° · Spatial audio</span>
                                    <span class="film__action">
                                        Watch on YouTube <span aria-hidden="true">↗</span>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </article>
                ))
            }
        </div>

    </div>
</section>

<style>
    .productions {
        padding: var(--tw-section-y) var(--tw-section-x);
        background: var(--tw-bg-alt);
        scroll-margin-top: 88px;
    }

    .productions__inner {
        max-width: 1100px;
        margin: 0 auto;
    }

    .productions__heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 32px;
        margin-bottom: 40px;
    }

    .productions__kicker {
        margin: 0 0 18px;
        color: var(--tw-forest);
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .productions h2 {
        margin-bottom: 20px;
    }

    .productions__intro {
        max-width: 610px;
        margin-bottom: 0;
        color: var(--tw-secondary);
        font-size: 17px;
        line-height: 1.8;
    }

    .productions__channel {
        flex-shrink: 0;
        display: inline-flex;
        align-items: center;
        gap: 12px;
        min-height: 44px;
        padding: 10px 0;
        border-bottom: 1px solid var(--tw-forest);
        color: var(--tw-forest);
        font-size: 14px;
        font-weight: 600;
    }

    .productions__films {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 28px;
    }

    .film {
        min-width: 0;
    }

    .film__link {
        display: flex;
        flex-direction: column;
        height: 100%;
        overflow: hidden;
        border: 1px solid var(--tw-divider);
        border-radius: 8px;
        background: var(--tw-bg);
        color: var(--tw-text);
    }

    .film__image {
        position: relative;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        background: var(--tw-dark);
    }

    .film__image img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .film__play {
        position: absolute;
        right: 20px;
        bottom: 20px;
        display: grid;
        width: 48px;
        height: 48px;
        place-items: center;
        border: 1px solid rgba(255, 255, 255, 0.65);
        border-radius: 50%;
        background: var(--tw-darkest);
        color: #fff;
    }

    .film__play svg {
        width: 24px;
        height: 24px;
    }

    .film__copy {
        display: flex;
        flex: 1;
        flex-direction: column;
        padding: 26px;
    }

    .film__location {
        margin: 0 0 10px;
        color: var(--tw-forest);
        font-size: 12px;
        font-weight: 600;
    }

    .film h3 {
        margin: 0 0 12px;
        font-family: var(--tw-serif);
        font-size: 26px;
        font-weight: 400;
        line-height: 1.25;
        text-wrap: balance;
    }

    .film__description {
        margin: 0 0 26px;
        color: var(--tw-secondary);
        font-size: 15px;
        line-height: 1.7;
    }

    .film__footer {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: 14px;
        margin-top: auto;
        padding-top: 18px;
        border-top: 1px solid var(--tw-divider);
        font-size: 12px;
        line-height: 1.5;
    }

    .film__format {
        color: var(--tw-secondary);
    }

    .film__action {
        color: var(--tw-forest);
        font-weight: 600;
    }

    .film__link:hover,
    .film__link:focus-visible {
        border-color: var(--tw-forest);
    }

    .film__link:hover .film__play,
    .film__link:focus-visible .film__play {
        background: var(--tw-forest);
    }

    .film__link:focus-visible,
    .productions__channel:focus-visible {
        outline: 3px solid var(--tw-lake);
        outline-offset: 5px;
    }

    @media (max-width: 920px) {
        .productions__heading {
            align-items: flex-start;
            flex-direction: column;
            gap: 20px;
        }

        .productions__films {
            grid-template-columns: 1fr;
        }
    }

    @media (max-width: 760px) {
        .film__copy {
            padding: 22px;
        }

        .film h3 {
            font-size: 24px;
        }

        .productions__intro {
            font-size: 16px;
        }
    }
</style>
