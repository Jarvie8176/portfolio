---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const isWorkPath = pathname === '/work/' || pathname.startsWith('/projects/');
const isContactPath = pathname === '/contact/';
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label={`${site.name} home`}>
    <strong>{site.name}</strong>
  </a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#work" aria-current={isWorkPath ? 'page' : undefined}>Work</a>
    <a href="/contact/" aria-current={isContactPath ? 'page' : undefined}>Contact</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--site-header-min);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0 max(32px, 5vw);
    background: var(--paper);
  }

  .site-brand {
    min-width: 0;
    display: grid;
    gap: 1px;
    color: var(--ink);
    text-decoration: none;
  }

  .site-brand strong {
    font-family: var(--serif);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.2;
  }

  .site-nav {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 18px;
    line-height: 1;
  }

  .site-nav a {
    padding: 1rem 0.25rem;
    color: var(--ink);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
  }

  .site-nav a:hover,
  .site-nav a[aria-current="page"] {
    color: var(--worlds);
  }

  .site-brand:focus-visible,
  .site-nav a:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .site-header {
      padding: 0 20px;
    }
  }
</style>
