---
import { site } from '../data/site';

const pathname = Astro.url.pathname;
const isWorkPath = pathname === '/work/' || pathname.startsWith('/projects/');
const isContactPath = pathname === '/contact/';
const showPracticeNav = !isContactPath;
---

<header class="site-header">
  <div class="site-primary">
    <a class="site-brand" href="/" aria-label={`${site.name} home`}>{site.name}</a>
    <nav class="site-nav" aria-label="Primary">
      <a href="/work/" aria-current={isWorkPath ? 'page' : undefined}>Work</a>
      <a href="/contact/" aria-current={isContactPath ? 'page' : undefined}>Contact</a>
    </nav>
  </div>
  {showPracticeNav && (
    <nav class="practice-nav" aria-label="Practice sections">
      <a href="/work/#systems">Systems</a>
      <span aria-hidden="true">/</span>
      <a href="/work/#embodied">Embodied Life</a>
      <span aria-hidden="true">/</span>
      <a href="/work/#worlds">Inhabited Worlds</a>
    </nav>
  )}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--site-header-min);
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.5rem;
    padding: 0.75rem clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-primary {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: clamp(1.35rem, 3vw, 2.5rem);
  }

  .site-brand {
    flex: 0 0 auto;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
  }

  .practice-nav {
    min-width: 0;
    display: flex;
    align-items: baseline;
    justify-content: flex-end;
    gap: 0.42rem;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-align: right;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .practice-nav a {
    color: inherit;
    text-decoration: none;
  }

  .practice-nav a:hover {
    color: var(--ink-soft);
  }

  .site-nav {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
  }

  .site-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .site-nav a[aria-current="page"] {
    color: var(--ink);
  }

  @media (max-width: 680px) {
    .site-header {
      position: static;
      grid-template-columns: 1fr;
      align-items: stretch;
      gap: 0.8rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .site-primary {
      width: 100%;
      flex-wrap: wrap;
      gap: 0.85rem 1.35rem;
    }

    .site-nav {
      justify-content: flex-start;
      gap: 0.7rem;
      font-size: 0.82rem;
    }

    .practice-nav {
      justify-content: flex-start;
      text-align: left;
      white-space: normal;
    }
  }
</style>
