---
import { site } from '../data/site';

interface Props {
  crumb?: string;
}

const { crumb } = Astro.props as Props;
const subtitle = crumb ?? site.headerSubtitle;
---

<header class="site-header">
  <div class="site-identity">
    <a class="site-brand" href="/" aria-label={`${site.name} home`}>{site.name}</a>
    {subtitle && <span class="site-subtitle">{subtitle}</span>}
  </div>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/#contact">Contact</a>
  </nav>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--site-header-min);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding: 0.75rem clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
    background: color-mix(in srgb, var(--paper) 92%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-identity {
    min-width: 0;
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
  }

  .site-brand {
    flex: 0 0 auto;
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
  }

  .site-subtitle {
    min-width: 0;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    overflow: hidden;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .site-nav {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
  }

  .site-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  @media (max-width: 680px) {
    .site-header {
      position: static;
      flex-direction: column;
      align-items: start;
      gap: 0.8rem;
      padding-top: 1rem;
      padding-bottom: 1rem;
    }

    .site-identity {
      width: 100%;
      display: grid;
      gap: 0.35rem;
    }

    .site-subtitle {
      white-space: normal;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.7rem;
      font-size: 0.82rem;
    }

  }
</style>
