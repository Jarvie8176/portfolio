---
import { site } from '../data/site';

interface Props {
  crumb?: string;
}

const { crumb } = Astro.props as Props;
---

<header class="site-header">
  <a class="site-brand" href="/" aria-label={`${site.name} home`}>{site.name}</a>
  <nav class="site-nav" aria-label="Primary">
    <a href="/#work">Work</a>
    <a href="/#notes">Notes</a>
    <a href="/#about">About</a>
    <span class="lang-switch" aria-label="Language switch"><span>中</span><b>/</b><span>EN</span></span>
  </nav>
  {crumb && <span class="site-crumb">{crumb}</span>}
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    min-height: var(--site-header-min);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 1rem;
    padding: 0.9rem clamp(1.5rem, 4vw, 4rem);
    border-bottom: 1px solid color-mix(in srgb, var(--rule) 72%, transparent);
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: blur(16px);
  }

  .site-brand {
    color: var(--ink);
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 650;
    line-height: 1;
    text-decoration: none;
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: clamp(1rem, 3vw, 2rem);
    color: var(--ink-soft);
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1;
  }

  .site-nav a {
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover {
    color: var(--ink);
  }

  .lang-switch {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2rem;
    padding: 0 0.7rem;
    border: 1px solid var(--rule);
    border-radius: 4px;
    color: var(--ink-soft);
    font-family: var(--mono);
    font-size: 0.78rem;
    white-space: nowrap;
  }

  .lang-switch b {
    color: var(--rule-hard);
    font-weight: 500;
  }

  .site-crumb {
    grid-column: 1 / -1;
    color: var(--ink-faint);
    font-family: var(--mono);
    font-size: var(--fs-meta);
  }

  @media (max-width: 680px) {
    .site-header {
      grid-template-columns: 1fr;
      align-items: start;
      gap: 0.8rem;
    }

    .site-nav {
      width: 100%;
      justify-content: space-between;
      gap: 0.7rem;
      font-size: 0.82rem;
    }

    .lang-switch {
      padding: 0 0.55rem;
    }
  }
</style>
