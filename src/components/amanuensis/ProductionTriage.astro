---
import { faThumbsUp, faArrowUp, faArrowDown, faVolumeXmark } from '@fortawesome/free-solid-svg-icons';
// Only the four fully visible entries in the supplied screenshot are recreated.
// Demo references are display labels, never live mailbox record identifiers.
const entries = [
  { level: 'drop', title: 'Forwarded SMS from: [number hidden]', text: 'Forwarded spam with garbled text and suspicious product listings. Likely a scam.', ref: 'sample-001' },
  { level: 'drop', title: 'Forwarded SMS from: [number hidden]', text: 'Suspected spam with a deceptive link and no useful business content.', ref: 'sample-002' },
  { level: 'drop', title: 'Forwarded SMS from: [number hidden]', text: 'A forwarded spam notification with no useful content.', ref: 'sample-003' },
  { level: 'ambient', title: '[Important] An agent becomes part of your IDE', text: 'An IDE product update: the next release includes an agent development tool that can be disabled.', ref: 'sample-004' },
];
const reactions = [
  { icon: faThumbsUp, label: 'Like' },
  { icon: faArrowUp, label: 'Higher priority' },
  { icon: faArrowDown, label: 'Lower priority' },
  { icon: faVolumeXmark, label: 'Mute' },
];
---

<figure class="triage-sample" aria-labelledby="triage-caption">
  <div class="thread-bar"><span aria-hidden="true">#</span> triage · sample <span>Anonymized sample</span></div>
  <div class="thread-body" lang="en">
    <h4>triage · inbox review</h4>
    <p class="thread-description">Inspect each classification, summary, and processing route</p>
    <div class="thread-author"><span class="avatar" aria-hidden="true">A</span><b>Amanuensis</b><span class="app-badge">APP</span></div>
    <ol class="triage-entries">
      {entries.map((entry) => (
        <li>
          <h5>{entry.title}</h5>
          <p class="route"><span class:list={['classification', entry.level]}>{entry.level === 'drop' && <span class="drop-dot" aria-hidden="true"></span>}{entry.level}</span> · personal · mailbox · local · qwen3.5-9b</p>
          <p class="entry-summary">{entry.text}</p>
          <code>mailbox/{entry.ref}</code>
          <ul class="reactions" aria-label="Static examples of the original message reactions">
            {reactions.map(({ icon, label }) => <li><svg role="img" aria-label={label} viewBox={`0 0 ${icon.icon[0]} ${icon.icon[1]}`}>{[icon.icon[4]].flat().map((path) => <path d={path} />)}</svg><span>1</span></li>)}
          </ul>
        </li>
      ))}
    </ol>
  </div>
  <figcaption id="triage-caption">Four complete entries from a separate production triage screenshot, with source numbers, mailbox references, and dates replaced. The reaction chips reproduce the source UI and are static in this preview. This excerpt is separate from the 18-message digest.</figcaption>
</figure>

<style>
  .triage-sample { margin: 0; border: 1px solid var(--rule-hard); background: #313338; color: #f2f3f5; }
  .thread-bar { display: flex; align-items: center; flex-wrap: wrap; gap: .6rem; padding: .85rem 1.1rem; border-bottom: 1px solid #4b4e55; font: 600 .78rem/1.5 var(--mono); }
  .thread-bar > span:first-child { color: #b5bac1; font-size: 1.1rem; }
  .thread-bar > span:last-child { margin-left: auto; font-size: .6rem; font-weight: 400; text-transform: uppercase; letter-spacing: .04em; color: #b5bac1; }
  .thread-body { padding: 1.4rem 1.1rem; }
  h4 { margin: 0; font: 700 clamp(1.4rem, 3vw, 1.9rem)/1.25 var(--sans); }
  .thread-description { margin: .45rem 0 1.4rem; font-size: .8rem; color: #b5bac1; }
  .thread-author { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; font-size: .85rem; }
  .avatar { display: grid; place-items: center; width: 1.9rem; height: 1.9rem; margin-right: .3rem; border-radius: 50%; background: #5865f2; font: 600 .9rem var(--mono); }
  .app-badge { padding: .1rem .3rem; background: #5865f2; border-radius: 2px; font: 600 .58rem/1.4 var(--sans); }
  .triage-entries { margin: .6rem 0 0 2.7rem; padding: 0; list-style: none; }
  .triage-entries > li + li { margin-top: 1.4rem; padding-top: 1.1rem; border-top: 1px solid #45474e; }
  h5 { margin: 0; font-size: .9rem; line-height: 1.5; font-weight: 700; }
  .route { margin: .2rem 0; font-size: .75rem; line-height: 1.7; color: #dbdee1; }
  .classification { display: inline-flex; align-items: center; gap: .3rem; font-family: var(--mono); }
  .drop-dot { width: .65rem; height: .65rem; border-radius: 50%; background: #e3e5e8; }
  .entry-summary { margin: 0 0 .35rem; font-size: .85rem; line-height: 1.8; color: #dbdee1; }
  code { display: inline-block; max-width: 100%; padding: .08rem .25rem; background: #2b2d31; border: 1px solid #4b4e55; border-radius: 3px; color: #dbdee1; font: .72rem/1.5 var(--mono); overflow-wrap: anywhere; }
  .reactions { display: flex; flex-wrap: wrap; gap: .3rem; list-style: none; padding: 0; margin: .4rem 0 0; }
  .reactions li { display: inline-flex; align-items: center; gap: .4rem; border-radius: 7px; padding: .15rem .5rem; background: #41434a; font-size: .8rem; line-height: 1.5; color: #dbdee1; }
  .reactions svg { width: .8rem; height: .8rem; fill: currentColor; }
  figcaption { padding: .85rem 1.1rem; border-top: 1px solid #4b4e55; font-size: .7rem; line-height: 1.7; color: #b5bac1; }
  h4, h5, p { overflow-wrap: anywhere; }
  @media (max-width: 560px) { .thread-body { padding: 1rem; } .triage-entries { margin-left: 0; } .thread-bar > span:last-child { width: 100%; margin-left: 0; } }
</style>
