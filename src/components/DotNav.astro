---
/**
 * DotNav — fixed right-hand section navigator.
 * Dots are "registration marks" in the field-notes idiom; the active
 * section's dot takes the vermillion stamp color. Scrollspy via
 * IntersectionObserver; hidden below 1100px (margin-note breakpoint).
 */
interface Item {
  id: string;
  label: string;
}
const { items } = Astro.props as { items: Item[] };
---
<nav class="dotnav" aria-label="Sections">
  {items.map((item) => (
    <a href={`#${item.id}`} data-dot={item.id}>
      <span class="dot-label">{item.label}</span>
      <span class="dot"></span>
    </a>
  ))}
</nav>

<script>
  const nav = document.querySelector('.dotnav');
  if (nav) {
    const links = [...nav.querySelectorAll('a')] as HTMLAnchorElement[];
    const sections = links
      .map((a) => document.getElementById(a.dataset.dot!))
      .filter((s): s is HTMLElement => s !== null);

    const setActive = (id: string) => {
      for (const a of links) {
        const active = a.dataset.dot === id;
        a.classList.toggle('is-active', active);
        if (active) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      }
    };

    // A horizontal band around the upper-middle of the viewport;
    // the section crossing it is the active one.
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) setActive(entry.target.id);
        }
      },
      { rootMargin: '-35% 0px -60% 0px' }
    );
    sections.forEach((s) => io.observe(s));
    if (sections[0]) setActive(sections[0].id);
  }
</script>

<style>
  .dotnav {
    position: fixed;
    right: 1.1rem;
    top: 50%;
    transform: translateY(-50%);
    z-index: 40;
    display: none;
    flex-direction: column;
    gap: 0.35rem;
  }
  @media (min-width: 1100px) {
    .dotnav { display: flex; }
  }

  .dotnav a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.6rem;
    padding: 0.3rem 0;
    text-decoration: none;
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    border: 1.5px solid var(--line-hard);
    background: var(--paper);
    transition: background 120ms ease, border-color 120ms ease, transform 120ms ease;
  }

  .dot-label {
    font-family: var(--mono);
    font-size: var(--fs-label);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0;
    transform: translateX(4px);
    transition: opacity 120ms ease, transform 120ms ease;
    pointer-events: none;
    white-space: nowrap;
  }

  .dotnav a:hover .dot { border-color: var(--ink-soft); background: var(--paper-3); }
  .dotnav a:hover .dot-label,
  .dotnav a.is-active .dot-label { opacity: 1; transform: translateX(0); }

  .dotnav a.is-active .dot {
    border-color: var(--stamp);
    background: var(--stamp);
    transform: scale(1.15);
  }
  .dotnav a.is-active .dot-label { color: var(--stamp); }
</style>
