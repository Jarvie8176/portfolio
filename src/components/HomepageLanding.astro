---
import { homepage, type PracticeId } from '../data/homepage';

interface Props {
  mode?: 'home' | 'work';
}

const { mode = 'home' } = Astro.props as Props;
const isWorkPage = mode === 'work';

const practiceClass: Record<PracticeId, string> = {
  systems: 'systems',
  'embodied-life': 'embodied',
  'inhabited-worlds': 'worlds',
};

const materialStyle = ({ from, to }: { from: string; to: string }) =>
  `--m-from: ${from}; --m-to: ${to};`;
---

<main class:list={['landing', { 'landing-work': isWorkPage }]}>
  <section class="hero" aria-labelledby="hero-title">
    <div class="section-inner">
      <h1 id="hero-title">
        {isWorkPage ? 'Selected work across systems, bodies, and worlds.' : homepage.hero.h1}
      </h1>
      <p class="bridge">{homepage.hero.bridge}</p>
      <div class="cta-row" aria-label="Hero actions">
        {homepage.hero.ctas.map((cta) => (
          <a class:list={['button', cta.label === 'Contact' && 'secondary']} href={cta.href}>
            {cta.label}
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section compass-section" aria-labelledby="practices-label">
    <div class="section-inner">
      <div class="section-label" id="practices-label">{homepage.topicsLabel}</div>
      <div class="compass-grid">
        {homepage.practices.map((practice) => (
          <a
            class:list={['compass-panel', practiceClass[practice.id]]}
            href={`#${practice.id}`}
            aria-label={`${practice.title}: ${practice.lead}`}
          >
            <div class="compass-copy">
              <h3>{practice.title}</h3>
              <p class="lead">{practice.lead}</p>
              <p class="meaning">{practice.meaning}</p>
            </div>
            <span class="compass-projects">{practice.related}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section work-section" id="work" aria-label="Selected work">
    <div class="section-inner">
      <div class="work-groups">
        {homepage.workGroups.map((group) => (
          <section class="work-group" id={group.id} aria-labelledby={`${group.id}-label`}>
            <div class:list={['group-head', practiceClass[group.id]]}>
              <span class="section-label group-label" id={`${group.id}-label`}>{group.label}</span>
              <h3 class="thesis-claim">{group.thesis.claim}</h3>
              <p class="thesis-body">{group.thesis.body}</p>
            </div>
            <div class="project-grid">
              {group.projects.map((project) => (
                <article class="project-card" id={project.id}>
                  <a
                    class="project-media"
                    href={project.href}
                    style={materialStyle(project.material)}
                    aria-label={`${project.name} project`}
                  ></a>
                  <div class="project-copy">
                    <h4><a href={project.href}>{project.name}</a></h4>
                    <p>{project.introduction}</p>
                    <a class="project-link" href={project.href}>View <span aria-hidden="true">&rarr;</span></a>
                  </div>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="contact-section" id="contact" aria-labelledby="contact-title">
    <div class="section-inner">
      <p class="invite" id="contact-title">{homepage.contact.invitation}</p>
      <div class="cta-row" aria-label="Contact actions">
        {homepage.contact.ctas.map((cta) => (
          <a class:list={['button', cta.label === 'View Work' && 'quiet']} href={cta.href}>
            {cta.label}
          </a>
        ))}
      </div>
    </div>
  </section>
</main>

<style>
  .landing {
    --max: 1296px;
    color: var(--ink);
    background: var(--paper);
    font-family: var(--sans);
  }

  .landing a:focus-visible {
    outline: 2px solid #111111;
    outline-offset: 4px;
  }

  .section-inner {
    width: min(var(--max), 100%);
    margin: 0 auto;
    padding: 0 32px;
  }

  h1,
  h3,
  h4,
  p {
    margin: 0;
  }

  /* Hero */
  .hero {
    padding: 50px 0 70px;
  }

  .hero h1 {
    max-width: 720px;
    font-size: 46px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.18;
  }

  .bridge {
    max-width: 650px;
    margin-top: 27px;
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.6;
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 14px;
  }

  .button {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--ink);
    padding: 0 26px;
    background: var(--ink);
    color: var(--paper);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.06em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .button:hover {
    border-color: var(--worlds);
    background: var(--worlds);
    color: var(--paper);
  }

  .button.secondary,
  .button.quiet {
    background: transparent;
    color: var(--ink);
  }

  .button.quiet {
    border-color: var(--rule);
  }

  .button.secondary:hover,
  .button.quiet:hover {
    border-color: var(--worlds);
    background: transparent;
    color: var(--worlds);
  }

  /* Section scaffolding */
  .section {
    padding: 70px 0;
  }

  .section-label {
    display: block;
    color: var(--ink-soft);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* S1 — practice compass */
  .compass-section {
    padding-top: 70px;
  }

  .compass-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 34px;
  }

  .compass-panel {
    min-height: 380px;
    display: grid;
    align-content: space-between;
    gap: 28px;
    border-left: 4px solid currentColor;
    padding: 40px;
    background: var(--surface);
    text-decoration: none;
    transition: background 160ms ease;
  }

  .compass-panel:hover,
  .compass-panel:focus-visible {
    background: var(--paper-3);
  }

  .systems { color: var(--systems); }
  .embodied { color: var(--embodied); }
  .worlds { color: var(--worlds); }

  .compass-copy {
    display: grid;
    gap: 18px;
  }

  .compass-panel h3 {
    color: var(--ink);
    font-size: 28px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .compass-panel .lead {
    color: var(--ink-soft);
    font-size: 18px;
    line-height: 1.35;
  }

  .compass-panel .meaning {
    color: var(--ink-soft);
    font-size: 13px;
    line-height: 1.35;
  }

  .compass-projects {
    color: currentColor;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.2;
  }

  /* S2 — selected work index */
  .work-section {
    padding-top: 70px;
    padding-bottom: 60px;
  }

  .work-groups {
    display: grid;
    gap: 52px;
  }

  .group-head {
    display: grid;
    gap: 14px;
  }

  .group-label {
    color: currentColor;
  }

  .thesis-claim {
    color: var(--ink);
    font-size: 24px;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.25;
  }

  .thesis-body {
    max-width: 680px;
    color: var(--ink-soft);
    font-size: 16px;
    line-height: 1.45;
  }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 36px;
    margin-top: 24px;
  }

  .project-card {
    min-height: 450px;
    display: grid;
    grid-template-rows: 200px auto;
    background: var(--surface);
  }

  .project-media {
    display: block;
    background: linear-gradient(180deg, var(--m-from), var(--m-to));
  }

  .project-copy {
    display: grid;
    align-content: start;
    gap: 14px;
    padding: 28px;
  }

  .project-copy h4 {
    font-size: 21px;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.2;
  }

  .project-copy h4 a {
    color: var(--ink);
    text-decoration: none;
  }

  .project-copy h4 a:hover {
    color: var(--worlds);
  }

  .project-copy p {
    color: var(--ink);
    font-size: 15px;
    line-height: 1.5;
  }

  .project-link {
    justify-self: start;
    color: var(--accent);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }

  .project-link:hover {
    color: var(--worlds);
  }

  /* S4 — contact */
  .contact-section {
    padding: 60px 0 100px;
  }

  .invite {
    max-width: 604px;
    color: var(--ink);
    font-size: 22px;
    line-height: 1.35;
  }

  .contact-section .cta-row {
    margin-top: 72px;
  }

  @media (max-width: 1080px) {
    .compass-grid {
      grid-template-columns: 1fr;
    }

    .compass-panel {
      min-height: 0;
    }

    .hero h1 {
      font-size: 38px;
    }
  }

  @media (max-width: 900px) {
    .project-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .section-inner {
      padding: 0 20px;
    }

    .hero {
      padding: 44px 0 64px;
    }

    .hero h1 {
      font-size: 34px;
      line-height: 1.16;
    }

    .bridge {
      font-size: 17px;
    }

    .section {
      padding: 56px 0;
    }

    .compass-panel {
      padding: 28px;
    }

    .work-groups {
      gap: 72px;
    }

    .invite {
      font-size: 20px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .landing *,
    .landing *::before,
    .landing *::after {
      transition: none !important;
    }
  }
</style>
