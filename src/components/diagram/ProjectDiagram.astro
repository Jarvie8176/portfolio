---
// Shared project architecture diagram.
// Build time: deterministic render of the canvas SoT -> inline SVG (works with
// zero JS). Runtime: a lazily loaded d3 island attaches semantic zoom / LOD.
import { renderSvg } from './render.mjs';

interface Props {
  canvasRaw: string;              // raw .canvas JSON (import with ?raw)
  accent?: 'systems' | 'embodied' | 'worlds';
  title: string;
  interactive?: boolean;
}
const { canvasRaw, accent = 'systems', title, interactive = true } = Astro.props;
const { svg } = renderSvg(canvasRaw, { title });
---

<figure class={`yd-figure yd-accent-${accent}`} data-interactive={interactive ? 'true' : 'false'}>
  <div class="yd-stage" set:html={svg}></div>
  <figcaption class="yd-caption sr-only">{title}</figcaption>
  {interactive && <p class="yd-hint" aria-hidden="true">double-click a layer to drill in - scroll or +/- to zoom - 0 to reset</p>}
</figure>

{interactive && (
  <script>
    import { mountDiagram } from './island.ts';
    for (const fig of document.querySelectorAll('.yd-figure[data-interactive="true"]')) {
      mountDiagram(fig as HTMLElement);
    }
  </script>
)}

<style>
  .yd-figure { margin: 0; position: relative; }
  .yd-stage :global(svg.yd-svg) { width: 100%; height: auto; display: block; overflow: visible; }
  .yd-accent-systems { --yd-accent: var(--systems, #2c4e8a); }
  .yd-accent-embodied { --yd-accent: var(--embodied, #657052); }
  .yd-accent-worlds { --yd-accent: var(--worlds, #985e49); }

  /* semantic zoom: per-layer detail is hidden at the high level and revealed
     on drill-in. No-JS baseline therefore shows the clean high-level view. */
  .yd-stage :global([data-lod="1"]) { opacity: 0; visibility: hidden; }
  .yd-figure[data-interactive="true"] .yd-stage :global([data-lod="1"]) { transition: opacity 220ms ease; }

  /* no-JS interaction baseline: hover/focus dims the rest */
  .yd-stage :global(.yd-node),
  .yd-stage :global(.yd-layer),
  .yd-stage :global(.yd-edge) { transition: opacity 160ms ease; }
  :global(.yd-stage:has(.yd-node:hover) .yd-node:not(:hover)),
  :global(.yd-stage:has(.yd-node:focus) .yd-node:not(:focus)) { opacity: 0.32; }
  .yd-stage :global(.yd-node:focus) { outline: none; }
  .yd-stage :global(.yd-node:focus) :global(rect),
  .yd-stage :global(.yd-node:focus) :global(polygon) { stroke-width: 3; }

  .yd-hint {
    margin: 0.5rem 0 0; font-size: 0.72rem; letter-spacing: 0.02em;
    color: var(--ink-faint, #8a8f92); text-align: center;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .yd-stage :global(.yd-node),
    .yd-stage :global(.yd-layer),
    .yd-stage :global(.yd-edge) { transition: none; }
  }
</style>
