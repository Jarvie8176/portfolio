---
// Shared project architecture diagram.
// Build time: deterministic render of the canvas SoT -> inline SVG (works with
// zero JS). Runtime: a lazily loaded d3 island attaches semantic zoom / LOD.
import { renderSvg } from './render.mjs';

interface Props {
  canvasRaw: string;              // raw .canvas JSON (import with ?raw)
  accent?: 'systems' | 'embodied' | 'worlds';
  title: string;
  interactive?: boolean;
}
const { canvasRaw, accent = 'systems', title, interactive = true } = Astro.props;
const { svg, model } = renderSvg(canvasRaw, { title });
const layerOrder = ['L0', 'L1', 'L2', 'L3', 'L4', 'L5'];
const layersWithDetail = new Set(model.nodes.filter((node) => node.lod > 0).map((node) => node.layer));
const drillLayers = [...model.groups]
  .filter((group) => layersWithDetail.has(group.layer))
  .sort((a, b) => layerOrder.indexOf(a.layer) - layerOrder.indexOf(b.layer))
  .map((group) => ({
    code: group.layer,
    label: group.label.replace(/^\s*[^-]+-\s*/, ''),
    title: group.label,
  }));
---

<figure class={`yd-figure yd-accent-${accent}`} data-interactive={interactive ? 'true' : 'false'}>
  <div class="yd-stage" set:html={svg}></div>
  <figcaption class="yd-caption sr-only">{title}</figcaption>
  {interactive && drillLayers.length > 0 && (
    <div class="yd-controls" aria-label="Diagram controls">
      <div class="yd-control-group" aria-label="Layer detail toggles">
        <span class="yd-controls-label">Layer detail</span>
        <div class="yd-control-row">
          <button
            type="button"
            data-yd-show-all
            aria-label="Show all layer detail"
            aria-pressed="false"
            title="Show all layer detail"
          >
            All
          </button>
          {drillLayers.map((layer) => (
            <button
              type="button"
              data-yd-drill-layer={layer.code}
              aria-label={`Toggle ${layer.title} detail`}
              aria-pressed="false"
              title={layer.title}
            >
              {layer.code}
            </button>
          ))}
          <button type="button" data-yd-reset disabled>Reset</button>
        </div>
      </div>
      <div class="yd-control-group" aria-label="Pan and zoom controls">
        <span class="yd-controls-label">View</span>
        <div class="yd-control-row">
          <button type="button" data-yd-zoom="out" aria-label="Zoom out" title="Zoom out">-</button>
          <button type="button" data-yd-zoom="in" aria-label="Zoom in" title="Zoom in">+</button>
          <button type="button" data-yd-pan="up" aria-label="Pan up" title="Pan up">↑</button>
          <button type="button" data-yd-pan="left" aria-label="Pan left" title="Pan left">←</button>
          <button type="button" data-yd-pan="right" aria-label="Pan right" title="Pan right">→</button>
          <button type="button" data-yd-pan="down" aria-label="Pan down" title="Pan down">↓</button>
          <button type="button" data-yd-fit aria-label="Fit active layer detail" title="Fit active layer detail">Fit</button>
        </div>
      </div>
      <p class="yd-hint">Double-click a layer to show detail. Use Fit to focus the active detail.</p>
      <span class="yd-status sr-only" data-yd-status aria-live="polite">High-level view</span>
    </div>
  )}
</figure>

{interactive && (
  <script>
    import { mountDiagram } from './island.ts';
    for (const fig of document.querySelectorAll('.yd-figure[data-interactive="true"]')) {
      mountDiagram(fig as HTMLElement);
    }
  </script>
)}

<style>
  .yd-figure { margin: 0; position: relative; }
  .yd-stage { overflow: hidden; }
  .yd-stage :global(svg.yd-svg) { width: 100%; height: auto; display: block; overflow: hidden; }
  .yd-accent-systems { --yd-accent: var(--systems, #2c4e8a); }
  .yd-accent-embodied { --yd-accent: var(--embodied, #657052); }
  .yd-accent-worlds { --yd-accent: var(--worlds, #985e49); }

  /* semantic zoom: per-layer detail is hidden at the high level and revealed
     on drill-in. No-JS baseline therefore shows the clean high-level view. */
  .yd-stage :global([data-lod="1"]) { opacity: 0; visibility: hidden; }
  .yd-figure[data-interactive="true"] .yd-stage :global([data-lod="1"]) { transition: opacity 220ms ease; }
  .yd-stage :global([data-lod="1"][data-layer-active="true"]) {
    opacity: 1;
    visibility: visible;
  }

  /* no-JS interaction baseline: hover/focus dims the rest */
  .yd-stage :global(.yd-node),
  .yd-stage :global(.yd-layer),
  .yd-stage :global(.yd-edge) { transition: opacity 160ms ease; }
  :global(.yd-stage:has(.yd-node:hover) .yd-node:not(:hover)),
  :global(.yd-stage:has(.yd-node:focus) .yd-node:not(:focus)) { opacity: 0.32; }
  .yd-stage :global(.yd-node:focus) { outline: none; }
  .yd-stage :global(.yd-node:focus) :global(rect),
  .yd-stage :global(.yd-node:focus) :global(polygon) { stroke-width: 3; }

  .yd-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.8rem 1.1rem;
    margin: 0.9rem 0 0;
    padding-top: 0.85rem;
    border-top: 1px solid color-mix(in srgb, var(--rule, #d8d8d2) 80%, transparent);
  }
  .yd-control-group {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
  }
  .yd-controls-label {
    color: var(--ink-faint, #8a8f92);
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .yd-control-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.35rem;
  }
  .yd-control-row button {
    min-width: 2.3rem;
    min-height: 2rem;
    padding: 0.25rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--yd-accent) 45%, var(--rule, #d8d8d2));
    border-radius: 3px;
    background: var(--surface, #fffefa);
    color: var(--yd-accent);
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.72rem;
    font-weight: 800;
    cursor: pointer;
  }
  .yd-control-row button:hover,
  .yd-control-row button:focus-visible,
  .yd-control-row button[aria-pressed="true"] {
    background: color-mix(in srgb, var(--yd-accent) 9%, var(--surface, #fffefa));
    border-color: var(--yd-accent);
  }
  .yd-control-row button:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--yd-accent) 55%, transparent);
    outline-offset: 2px;
  }
  .yd-control-row button:disabled {
    cursor: default;
    opacity: 0.45;
  }
  .yd-control-row button:disabled:hover {
    background: var(--surface, #fffefa);
    border-color: color-mix(in srgb, var(--yd-accent) 45%, var(--rule, #d8d8d2));
  }
  .yd-hint {
    flex-basis: 100%;
    margin: -0.15rem 0 0;
    color: var(--ink-faint, #8a8f92);
    font-family: var(--mono, ui-monospace, monospace);
    font-size: 0.68rem;
    line-height: 1.4;
    text-align: center;
  }
  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .yd-stage :global(.yd-node),
    .yd-stage :global(.yd-layer),
    .yd-stage :global(.yd-edge) { transition: none; }
  }
</style>
