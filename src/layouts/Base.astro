---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import { build } from '../data/build';
import { site } from '../data/site';

interface Props {
  title: string;
  description: string;
  /** breadcrumb shown top-right, e.g. "projects / beagle" */
  crumb?: string;
  ogType?: string;
  wide?: boolean;
}
const { title, description, crumb, ogType = 'website', wide = false } = Astro.props;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    {Astro.site && <link rel="sitemap" href="/sitemap-index.xml" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Noto+Sans:wght@400;500;600;700&family=Noto+Sans+Mono:wght@400;500;600;700&family=Noto+Sans+SC:wght@400;500;600;700&family=Noto+Serif:wght@400;500;600;700&family=Noto+Serif+SC:wght@400;600;700&text=%E4%B8%AD%E6%96%87%E6%97%A5%E6%9C%AC%E8%AA%9E%E5%BC%80%E6%94%BE%E4%B8%96%E7%95%8C%E8%A7%82%E5%AF%9F%E7%AC%94%E8%AE%B0&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <SiteHeader crumb={crumb} />
    <div class:list={['page', { 'page--wide': wide }]}>
      <slot />
      <footer class="site-foot">
        <span class="meta">{site.name}</span>
        <span class="meta-row">
          <span class="meta version-tag" aria-label={`Version ${build.version}`}>v{build.version}</span>
          <span class="meta"><a href="/colophon/">colophon</a></span>
        </span>
      </footer>
    </div>
  </body>
</html>
